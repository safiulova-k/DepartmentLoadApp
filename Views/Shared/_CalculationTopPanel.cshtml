@model DepartmentLoadApp.ViewModels.Shared.CalculationTopPanelViewModel

@{
    var currentController = Model.ActiveTab switch
    {
        "practice" => "PracticeCalculation",
        "gia" => "GiaCalculation",
        _ => "WorkloadCalculation"
    };
}

<div class="d-flex flex-wrap gap-3 align-items-end mb-4">
    <div>
        <label class="form-label fw-semibold d-block">Год начала расчета</label>
        <div class="btn-group" role="group">
            @foreach (var year in Model.AvailableYearStarts)
            {
                <a asp-controller="@currentController"
                   asp-action="Index"
                   asp-route-startYear="@year"
                   class="btn @(year == Model.SelectedYearStart ? "btn-primary" : "btn-outline-primary")">
                    @year
                </a>
            }
        </div>
    </div>

    <div style="min-width: 170px;">
        <label class="form-label fw-semibold">Учебный год</label>
        <input class="form-control" value="@Model.SelectedYear" readonly />
    </div>

    <div class="d-flex gap-2">
        <form asp-controller="@currentController"
              asp-action="ImportFromAcademicPlan"
              asp-route-startYear="@Model.SelectedYearStart"
              method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success">Рассчитать</button>
        </form>

        <a asp-controller="@currentController"
           asp-action="ExportToExcel"
           asp-route-startYear="@Model.SelectedYearStart"
           class="btn btn-outline-success">
            Выгрузить в Excel
        </a>
    </div>
</div>

<div class="btn-group mb-4" role="group">
    <a asp-controller="WorkloadCalculation"
       asp-action="Index"
       asp-route-startYear="@Model.SelectedYearStart"
       class="btn @(Model.ActiveTab == "workload" ? "btn-dark" : "btn-outline-dark")">
        Дисциплины
    </a>

    <a asp-controller="PracticeCalculation"
       asp-action="Index"
       asp-route-startYear="@Model.SelectedYearStart"
       class="btn @(Model.ActiveTab == "practice" ? "btn-dark" : "btn-outline-dark")">
        Практики
    </a>

    <a asp-controller="GiaCalculation"
       asp-action="Index"
       asp-route-startYear="@Model.SelectedYearStart"
       class="btn @(Model.ActiveTab == "gia" ? "btn-dark" : "btn-outline-dark")">
        ГИА
    </a>
</div>