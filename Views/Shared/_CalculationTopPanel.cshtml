@model DepartmentLoadApp.ViewModels.Shared.CalculationTopPanelViewModel

@{
    const int minAvailableStartYear = 2018;

    var currentAcademicStartYear = DateTime.Now.Month >= 9
        ? DateTime.Now.Year
        : DateTime.Now.Year - 1;

    var maxAvailableStartYear = currentAcademicStartYear + 1;

    var availableYearStarts = Enumerable
        .Range(minAvailableStartYear, maxAvailableStartYear - minAvailableStartYear + 1)
        .ToList();

    var controllerName = Model.ActiveTab switch
    {
        "workload" => "WorkloadCalculation",
        "practice" => "PracticeCalculation",
        "gia" => "GiaCalculation",
        _ => "WorkloadCalculation"
    };

    var workloadTabClass = Model.ActiveTab == "workload"
        ? "btn-primary"
        : "btn-outline-primary";

    var practiceTabClass = Model.ActiveTab == "practice"
        ? "btn-primary"
        : "btn-outline-primary";

    var giaTabClass = Model.ActiveTab == "gia"
        ? "btn-primary"
        : "btn-outline-primary";
}

<style>
    .calculation-top-panel {
        margin-bottom: 16px;
    }

    .calculation-toolbar {
        display: grid;
        grid-template-columns: 150px minmax(220px, 1fr) 190px 190px 170px 145px 145px;
        gap: 10px;
        align-items: end;
        margin-bottom: 12px;
    }

    .calculation-tabs {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 14px;
    }

    .calculation-action-button {
        width: 100%;
        min-width: 130px;
        height: 31px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
    }

    .calculation-year-select {
        max-height: 220px;
        overflow-y: auto;
    }

    .calculation-direction-dropdown .dropdown-menu {
        max-height: 260px;
        overflow-y: auto;
        min-width: 260px;
    }

    .calculation-direction-option {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 2px;
        font-size: 0.9rem;
        cursor: pointer;
    }

    .direction-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 12px;
    }

    .direction-legend-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid #dee2e6;
        border-radius: 999px;
        padding: 4px 10px;
        background: #fff;
        font-size: 0.88rem;
    }

    .direction-legend-color {
        width: 18px;
        height: 18px;
        border-radius: 999px;
        border: 1px solid rgba(0, 0, 0, 0.12);
        flex: 0 0 auto;
    }

    .calculation-row-colored > td {
        background-color: var(--direction-color) !important;
    }

    @@media (max-width: 1399.98px) {
        .calculation-toolbar {
            grid-template-columns: 150px minmax(220px, 1fr) 180px 180px;
        }
    }

    @@media (max-width: 991.98px) {
        .calculation-toolbar {
            grid-template-columns: 1fr;
        }

        .calculation-action-button {
            width: 100%;
        }
    }
</style>

<div class="calculation-top-panel">
    <form asp-controller="@controllerName"
          asp-action="Index"
          method="get"
          class="calculation-toolbar">

        <div>
            <label class="form-label">Учебный год</label>
            <select name="startYear"
                    class="form-select form-select-sm calculation-year-select"
                    onchange="this.form.submit()">
                @foreach (var year in availableYearStarts)
                {
                    var text = $"{year}-{year + 1}";

                    if (year == Model.SelectedYearStart)
                    {
                        <option value="@year" selected>@text</option>
                    }
                    else
                    {
                        <option value="@year">@text</option>
                    }
                }
            </select>
        </div>

        <div>
            <label class="form-label">Поиск</label>
            <input type="text"
                   class="form-control form-control-sm js-calculation-search"
                   placeholder="Введите название, направление или семестр" />
        </div>

        <div>
            <label class="form-label">Фильтр</label>
            <select class="form-select form-select-sm js-calculation-filter">
                <option value="all">Все строки</option>
                <option value="autumn">Осень</option>
                <option value="spring">Весна</option>

                @if (Model.ActiveTab == "workload")
                {
                    <option value="merged">Объединенные потоки</option>
                    <option value="exam">С экзаменом</option>
                    <option value="credit">С зачетом</option>
                }

                @if (Model.ActiveTab == "gia")
                {
                    <option value="state-exam">Госэкзамен</option>
                    <option value="vkr">Дипломное проектирование</option>
                    <option value="gek">ГЭК</option>
                }
            </select>
        </div>

        <div>
            <label class="form-label">Сортировка</label>
            <select class="form-select form-select-sm js-calculation-sort">
                <option value="name-asc">По дисциплине</option>
                <option value="course-asc">По курсу</option>
                <option value="direction-asc">По направлению</option>
            </select>
        </div>

        <div class="calculation-direction-dropdown">
            <label class="form-label">Направления</label>
            <div class="dropdown">
                <button class="btn btn-sm btn-outline-secondary dropdown-toggle w-100 js-direction-filter-button"
                        type="button"
                        data-bs-toggle="dropdown"
                        data-bs-auto-close="outside"
                        aria-expanded="false">
                    Все направления
                </button>

                <div class="dropdown-menu p-2 js-direction-filter-menu">
                    <div class="text-muted small px-1">
                        Направления появятся после загрузки таблицы.
                    </div>
                </div>
            </div>
        </div>

        <div>
            <label class="form-label d-none d-lg-block">&nbsp;</label>
            <button type="submit"
                    class="btn btn-sm btn-outline-secondary calculation-action-button">
                Показать
            </button>
        </div>
    </form>

    <div class="calculation-toolbar">
        <div>
            <form asp-controller="@controllerName"
                  asp-action="ImportFromAcademicPlan"
                  method="post"
                  class="m-0">
                @Html.AntiForgeryToken()

                <input type="hidden" name="startYear" value="@Model.SelectedYearStart" />

                <button type="submit"
                        class="btn btn-sm btn-primary calculation-action-button">
                    Рассчитать
                </button>
            </form>
        </div>

        <div>
            <a asp-controller="@controllerName"
               asp-action="ExportToExcel"
               asp-route-startYear="@Model.SelectedYearStart"
               class="btn btn-sm btn-success calculation-action-button">
                Выгрузить в Excel
            </a>
        </div>
    </div>

    <div class="calculation-tabs">
        <a asp-controller="WorkloadCalculation"
           asp-action="Index"
           asp-route-startYear="@Model.SelectedYearStart"
           class="btn btn-sm @workloadTabClass">
            Дисциплины
        </a>

        <a asp-controller="PracticeCalculation"
           asp-action="Index"
           asp-route-startYear="@Model.SelectedYearStart"
           class="btn btn-sm @practiceTabClass">
            Практики
        </a>

        <a asp-controller="GiaCalculation"
           asp-action="Index"
           asp-route-startYear="@Model.SelectedYearStart"
           class="btn btn-sm @giaTabClass">
            ГИА
        </a>
    </div>
</div>