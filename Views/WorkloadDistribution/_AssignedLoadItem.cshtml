@model DepartmentLoadApp.ViewModels.WorkloadDistribution.WorkloadDistributionAssignmentViewModel

@{
    var selectedYearStart = ViewData["SelectedYearStart"] as int? ?? 0;
    var selectedLecturerId = ViewData["SelectedLecturerId"] as int?;
}

<div class="border rounded-3 p-3 mb-2 bg-light">
    <div class="d-flex justify-content-between align-items-start gap-3">

        <div class="flex-grow-1">
            <div class="fw-semibold">
                @Model.Title
            </div>

            <div class="text-muted small mb-2">
                @Model.Subtitle
            </div>

            <div class="d-flex flex-wrap gap-2 small">
                <span class="badge text-bg-primary">
                    @Model.ElementDisplayName
                </span>

                @if (!string.IsNullOrWhiteSpace(Model.UnitName))
                {
                    <span class="badge text-bg-light border text-dark">
                        @Model.UnitName
                    </span>
                }

                @if (Model.StudentsCount > 0)
                {
                    <span class="badge text-bg-light border text-dark">
                        @Model.StudentsCount студ.
                    </span>
                }

                <span class="badge text-bg-success">
                    @Model.AssignedHours.ToString("0.##") ч.
                </span>
            </div>
        </div>

        <form asp-action="DeleteAssignment"
              asp-controller="WorkloadDistribution"
              method="post"
              class="m-0"
              onsubmit="return confirm('Удалить эту нагрузку у преподавателя?');">

            @Html.AntiForgeryToken()

            <input type="hidden" name="SelectedYearStart" value="@selectedYearStart" />
            <input type="hidden" name="SelectedLecturerId" value="@selectedLecturerId" />
            <input type="hidden" name="AssignmentId" value="@Model.AssignmentId" />

            <button type="submit"
                    class="btn btn-outline-danger btn-sm">
                Удалить
            </button>
        </form>

    </div>
</div>