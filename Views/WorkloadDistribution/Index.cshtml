                                    <div id="@additionalSectionId" class="accordion-collapse collapse">
                                        <div class="accordion-body">
                                            <div class="alert alert-light border distribution-empty-section @(additionalAssignments.Any() ? "d-none" : "")">
                                                Назначенной дополнительной работы нет.
                                            </div>

                                            @if (additionalAssignments.Any())
                                            {
                                                <div class="distribution-view-additional-list js-view-subjects">
                                                    @foreach (var workType in additionalWorkTypeGroups)
                                                    {
                                                        <div class="distribution-view-additional-row js-view-worktype-row">
                                                            <div class="distribution-view-additional-title">
                                                                @workType.Key:
                                                            </div>

                                                            <div class="distribution-chip-list">
                                                                @foreach (var assignment in workType.OrderBy(x => x.UnitName))
                                                                {
                                                                    <div class="distribution-chip distribution-assigned-chip js-assigned-chip"
                                                                         data-hours="@assignment.AssignedHours.ToString("0.####").Replace(",", ".")">
                                                                        <span class="distribution-chip-main">
                                                                            <span class="distribution-chip-title">
                                                                                @(string.IsNullOrWhiteSpace(assignment.UnitName)
                                                                                    ? assignment.ElementDisplayName
                                                                                    : assignment.UnitName)
                                                                            </span>

                                                                            <span class="distribution-chip-meta">
                                                                                @assignment.AssignedHours.ToString("0.##") ч.
                                                                                @if (assignment.StudentsCount > 0)
                                                                                {
                                                                                    <span> · @assignment.StudentsCount асп.</span>
                                                                                }
                                                                            </span>
                                                                        </span>

                                                                        <form asp-action="DeleteAssignment"
                                                                              method="post"
                                                                              class="m-0 js-delete-assignment-form"
                                                                              data-lecturer-id="@lecturer.LecturerId"
                                                                              data-hours="@assignment.AssignedHours.ToString("0.####").Replace(",", ".")">
                                                                            @Html.AntiForgeryToken()

                                                                            <input type="hidden" name="SelectedYearStart" value="@Model.SelectedYearStart" />
                                                                            <input type="hidden" name="SelectedLecturerId" value="@lecturer.LecturerId" />
                                                                            <input type="hidden" name="AssignmentId" value="@assignment.AssignmentId" />

                                                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                                                ×
                                                                            </button>
                                                                        </form>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                Закрыть
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (autoDistributionResult != null)
{
    <div class="modal fade" id="autoDistributionResultModal" tabindex="-1" aria-labelledby="autoDistributionResultModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content auto-distribution-modal">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title" id="autoDistributionResultModalLabel">
                            Автоматически распределено
                        </h5>
                        <div class="text-muted small">
                            Учебный год: @autoDistributionResult.TargetAcademicYear
                        </div>
                    </div>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>

                <div class="modal-body">
                    @if (!autoDistributionResult.Groups.Any())
                    {
                        <div class="alert alert-info mb-0">
                            Новых назначений не создано.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border mb-3">
                            Создано назначений: <strong>@autoDistributionResult.CreatedAssignmentsCount</strong>.
                            История проверялась за годы:
                            <strong>@string.Join(", ", autoDistributionResult.HistoryAcademicYears)</strong>.
                        </div>

                        <div class="accordion" id="autoDistributionAccordion">
                            @for (var groupIndex = 0; groupIndex < autoDistributionResult.Groups.Count; groupIndex++)
                            {
                                var group = autoDistributionResult.Groups[groupIndex];
                                var collapseId = $"autoDistributionGroup_{groupIndex}";
                                var workTypeGroups = group.Assignments
                                .GroupBy(x => x.ElementName)
                                .OrderBy(x => GetAutoDistributionElementSortOrder(x.Key))
                                .ThenBy(x => x.Key)
                                .ToList();

                                <div class="accordion-item auto-distribution-item js-auto-distribution-group"
                                     data-total-hours="@group.TotalHours.ToString("0.####").Replace(",", ".")">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed"
                                                type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@collapseId"
                                                aria-expanded="false"
                                                aria-controls="@collapseId">
                                            <div class="d-flex justify-content-between align-items-center w-100 gap-3 pe-3">
                                                <div>
                                                    <div class="fw-semibold">
                                                        @group.LecturerName — @group.DisciplineName
                                                    </div>
                                                    <div class="small text-muted">
                                                        @group.Subtitle
                                                    </div>
                                                </div>

                                                <span class="badge bg-primary rounded-pill auto-distribution-total js-auto-group-total">
                                                    @group.TotalHours.ToString("0") ч.
                                                </span>
                                            </div>
                                        </button>
                                    </h2>

                                    <div id="@collapseId"
                                         class="accordion-collapse collapse"
                                         data-bs-parent="#autoDistributionAccordion">
                                        <div class="accordion-body">
                                            @foreach (var workTypeGroup in workTypeGroups)
                                            {
                                                <div class="auto-distribution-work-row js-auto-worktype-row">
                                                    <div class="auto-distribution-work-title">
                                                        @workTypeGroup.Key:
                                                    </div>

                                                    <div class="auto-distribution-pills">
                                                        @foreach (var assignment in workTypeGroup.OrderBy(x => x.UnitName))
                                                        {
                                                            <div class="auto-distribution-pill js-auto-assignment-row"
                                                                 data-hours="@assignment.Hours.ToString("0.####").Replace(",", ".")">
                                                                <span class="auto-distribution-pill-text">
                                                                    @FormatAutoDistributionUnitName(assignment.UnitName)
                                                                    · @assignment.Hours.ToString("0") ч.
                                                                </span>

                                                                <form asp-action="DeleteAssignment"
                                                                      method="post"
                                                                      class="auto-distribution-delete-form js-auto-delete-assignment-form"
                                                                      data-lecturer-id="@group.LecturerId"
                                                                      data-hours="@assignment.Hours.ToString("0.####").Replace(",", ".")">
                                                                    @Html.AntiForgeryToken()

                                                                    <input type="hidden" name="SelectedYearStart" value="@Model.SelectedYearStart" />
                                                                    <input type="hidden" name="SelectedLecturerId" value="@group.LecturerId" />
                                                                    <input type="hidden" name="AssignmentId" value="@assignment.AssignmentId" />

                                                                    <button type="submit"
                                                                            class="auto-distribution-pill-delete"
                                                                            title="Удалить">
                                                                        ×
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
                        Закрыть
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function parseNumber(value) {
            if (!value) {
                return 0;
            }

            return Number(String(value).replace(",", ".")) || 0;
        }

        function formatNumber(value) {
            const rounded = Math.round(value * 100) / 100;

            if (Number.isInteger(rounded)) {
                return String(rounded);
            }

            return String(rounded).replace(".", ",");
        }

        function setCheckboxChecked(checkbox, checked) {
            if (!checkbox || checkbox.disabled) {
                return;
            }

            if (checkbox.checked === checked) {
                return;
            }

            checkbox.checked = checked;
            checkbox.dispatchEvent(new Event("change", { bubbles: true }));
        }

        function updateChipState(modal) {
            modal.querySelectorAll(".js-load-chip").forEach(function (chip) {
                const checkbox = chip.querySelector(".js-load-item-checkbox");

                if (!checkbox) {
                    return;
                }

                chip.classList.toggle("selected", checkbox.checked);
            });
        }

        function updateModalHours(modal) {
            const remainingLimit = parseNumber(modal.dataset.remainingHours);
            let selectedHours = 0;

            modal.querySelectorAll(".js-load-item-checkbox:checked").forEach(function (checkbox) {
                selectedHours += parseNumber(checkbox.dataset.hours);
            });

            modal.querySelectorAll(".js-gia-students-input").forEach(function (input) {
                const students = parseNumber(input.value);
                const hoursPerStudent = parseNumber(input.dataset.hoursPerStudent);
                const rowHours = Math.round(students * hoursPerStudent);

                const row = input.closest(".distribution-gia-row");
                const rowHoursElement = row ? row.querySelector(".js-gia-row-hours") : null;

                if (rowHoursElement) {
                    rowHoursElement.textContent = formatNumber(rowHours);
                }

                selectedHours += rowHours;
            });

            modal.querySelectorAll(".js-additional-students-input").forEach(function (input) {
                const students = parseNumber(input.value);
                const hoursPerStudent = parseNumber(input.dataset.hoursPerStudent);
                const rowHours = Math.round(students * hoursPerStudent);

                const row = input.closest(".distribution-gia-row");
                const rowHoursElement = row ? row.querySelector(".js-additional-row-hours") : null;

                if (rowHoursElement) {
                    rowHoursElement.textContent = formatNumber(rowHours);
                }

                selectedHours += rowHours;
            });

            modal.querySelectorAll(".js-additional-hours-input").forEach(function (input) {
                const rowHours = parseNumber(input.value);

                const row = input.closest(".distribution-gia-row");
                const rowHoursElement = row ? row.querySelector(".js-additional-row-hours") : null;

                if (rowHoursElement) {
                    rowHoursElement.textContent = formatNumber(rowHours);
                }

                selectedHours += rowHours;
            });

            const afterAssign = remainingLimit - selectedHours;

            const selectedHoursElement = modal.querySelector(".js-selected-hours");
            const afterAssignElement = modal.querySelector(".js-after-assign-hours");
            const submitButton = modal.querySelector(".js-assign-selected-button");
            const warning = modal.querySelector(".js-limit-warning");

            if (selectedHoursElement) {
                selectedHoursElement.textContent = formatNumber(selectedHours);
            }

            if (afterAssignElement) {
                afterAssignElement.textContent = formatNumber(afterAssign);
            }

            if (submitButton && warning) {
                if (afterAssign < 0) {
                    submitButton.disabled = true;
                    warning.classList.remove("d-none");
                } else {
                    submitButton.disabled = false;
                    warning.classList.add("d-none");
                }
            }

            updateChipState(modal);
        }

        document.addEventListener("click", function (event) {
            const button = event.target.closest(".js-select-current-worktype");

            if (!button) {
                return;
            }

            const workTypeBlock = button.closest(".js-worktype-load-block");

            if (!workTypeBlock) {
                return;
            }

            workTypeBlock.querySelectorAll(".js-load-item-checkbox").forEach(function (checkbox) {
                setCheckboxChecked(checkbox, true);
            });
        });

        document.addEventListener("change", function (event) {
            if (!event.target.classList.contains("js-load-item-checkbox")
                && !event.target.classList.contains("js-gia-students-input")
                && !event.target.classList.contains("js-additional-students-input")
                && !event.target.classList.contains("js-additional-hours-input")) {
                return;
            }

            const modal = event.target.closest(".js-load-modal");

            if (modal) {
                updateModalHours(modal);
            }
        });

        document.addEventListener("input", function (event) {
            if (!event.target.classList.contains("js-gia-students-input")
                && !event.target.classList.contains("js-additional-students-input")
                && !event.target.classList.contains("js-additional-hours-input")) {
                return;
            }

            const modal = event.target.closest(".js-load-modal");

            if (modal) {
                updateModalHours(modal);
            }
        });

        document.querySelectorAll(".js-load-modal").forEach(function (modal) {
            modal.addEventListener("shown.bs.modal", function () {
                updateModalHours(modal);
            });
        });

        function updateLecturerRateInfo(select) {
            const lecturerId = select.dataset.lecturerId;
            const normHours = parseNumber(select.dataset.normHours);
            const assignedHours = parseNumber(select.dataset.assignedHours);
            const rate = parseNumber(select.value);

            const limitHours = Math.round(normHours * rate);
            const remainingHours = limitHours - assignedHours;

            document.querySelectorAll(`.js-rate-label[data-lecturer-id="${lecturerId}"]`).forEach(function (element) {
                element.textContent = select.options[select.selectedIndex].text;
            });

            document.querySelectorAll(`.js-effective-norm[data-lecturer-id="${lecturerId}"]`).forEach(function (element) {
                element.textContent = formatNumber(limitHours);
            });

            document.querySelectorAll(`.js-limit-badge[data-lecturer-id="${lecturerId}"]`).forEach(function (element) {
                element.textContent = formatNumber(limitHours);
            });

            document.querySelectorAll(`.js-remaining-badge[data-lecturer-id="${lecturerId}"]`).forEach(function (element) {
                element.textContent = formatNumber(remainingHours);
                element.dataset.value = String(remainingHours);
            });

            document.querySelectorAll(`.js-remaining-badge-wrapper[data-lecturer-id="${lecturerId}"]`).forEach(function (element) {
                element.classList.remove("bg-success", "bg-danger");
                element.classList.add(remainingHours < 0 ? "bg-danger" : "bg-success");
            });
        }

        document.addEventListener("change", function (event) {
            if (!event.target.classList.contains("js-rate-select")) {
                return;
            }

            updateLecturerRateInfo(event.target);
        });

        function updatePageHoursAfterDelete(hours) {
            const assignedElement = document.querySelector(".js-page-assigned-hours");
            const remainingElement = document.querySelector(".js-page-remaining-hours");

            if (assignedElement) {
                const newAssigned = Math.max(0, parseNumber(assignedElement.dataset.value) - hours);
                assignedElement.dataset.value = String(newAssigned);
                assignedElement.textContent = formatNumber(newAssigned);
            }

            if (remainingElement) {
                const newRemaining = parseNumber(remainingElement.dataset.value) + hours;
                remainingElement.dataset.value = String(newRemaining);
                remainingElement.textContent = formatNumber(newRemaining);
            }
        }

        function updateLecturerHoursAfterDelete(lecturerId, hours) {
            const assignedElements = document.querySelectorAll(`.js-lecturer-assigned-badge[data-lecturer-id="${lecturerId}"]`);
            const remainingElements = document.querySelectorAll(`.js-remaining-badge[data-lecturer-id="${lecturerId}"]`);
            const remainingWrappers = document.querySelectorAll(`.js-remaining-badge-wrapper[data-lecturer-id="${lecturerId}"]`);
            const rateSelects = document.querySelectorAll(`.js-rate-select[data-lecturer-id="${lecturerId}"]`);
            const lecturerCard = document.querySelector(`.js-lecturer-card[data-lecturer-id="${lecturerId}"]`);

            assignedElements.forEach(function (element) {
                const newAssigned = Math.max(0, parseNumber(element.dataset.value) - hours);
                element.dataset.value = String(newAssigned);
                element.textContent = formatNumber(newAssigned);

                if (lecturerCard) {
                    lecturerCard.dataset.assigned = String(newAssigned);
                }
            });

            remainingElements.forEach(function (element) {
                const newRemaining = parseNumber(element.dataset.value) + hours;
                element.dataset.value = String(newRemaining);
                element.textContent = formatNumber(newRemaining);

                if (lecturerCard) {
                    lecturerCard.dataset.remaining = String(newRemaining);
                    lecturerCard.dataset.overloaded = newRemaining < 0 ? "true" : "false";
                }

                remainingWrappers.forEach(function (wrapper) {
                    wrapper.classList.remove("bg-success", "bg-danger");
                    wrapper.classList.add(newRemaining < 0 ? "bg-danger" : "bg-success");
                });
            });

            rateSelects.forEach(function (select) {
                const currentAssigned = parseNumber(select.dataset.assignedHours);
                select.dataset.assignedHours = String(Math.max(0, currentAssigned - hours));
            });
        }

        function updateAddModalAfterDelete(lecturerId, hours) {
            const modal = document.getElementById(`loadModal_${lecturerId}`);

            if (!modal) {
                return;
            }

            const newRemaining = parseNumber(modal.dataset.remainingHours) + hours;
            modal.dataset.remainingHours = String(newRemaining);

            const freeHoursElement = modal.querySelector(".js-free-hours");

            if (freeHoursElement) {
                freeHoursElement.textContent = formatNumber(newRemaining);
            }

            updateModalHours(modal);
        }

        function updateViewModalHoursAfterDelete(modal, hours) {
            const assignedElement = modal.querySelector(".js-view-assigned-hours");
            const remainingElement = modal.querySelector(".js-view-remaining-hours");

            if (assignedElement) {
                const newAssigned = Math.max(0, parseNumber(assignedElement.dataset.value) - hours);
                assignedElement.dataset.value = String(newAssigned);
                assignedElement.textContent = formatNumber(newAssigned);
            }

            if (remainingElement) {
                const newRemaining = parseNumber(remainingElement.dataset.value) + hours;
                remainingElement.dataset.value = String(newRemaining);
                remainingElement.textContent = formatNumber(newRemaining);
                remainingElement.classList.toggle("text-danger", newRemaining < 0);
            }
        }

        function refreshViewSection(section) {
            const chips = section.querySelectorAll(".js-assigned-chip");
            let sectionHours = 0;

            chips.forEach(function (chip) {
                sectionHours += parseNumber(chip.dataset.hours);
            });

            const sectionHoursElement = section.querySelector(".js-view-section-hours");

            if (sectionHoursElement) {
                sectionHoursElement.textContent = formatNumber(sectionHours);
            }

            const emptySection = section.querySelector(".distribution-empty-section");

            if (emptySection) {
                emptySection.classList.toggle("d-none", chips.length > 0);
            }
        }

        function cleanupAfterChipDelete(chip) {
            const workTypeRow = chip.closest(".js-view-worktype-row");
            const subjectItem = chip.closest(".js-view-subject-item");
            const section = chip.closest(".js-view-section");

            chip.remove();

            if (workTypeRow && workTypeRow.querySelectorAll(".js-assigned-chip").length === 0) {
                workTypeRow.remove();
            }

            if (subjectItem && subjectItem.querySelectorAll(".js-assigned-chip").length === 0) {
                subjectItem.remove();
            }

            if (section) {
                refreshViewSection(section);
            }
        }

        async function deleteAssignment(form) {
            const response = await fetch(form.action, {
                method: "POST",
                body: new FormData(form),
                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                }
            });

            if (!response.ok) {
                throw new Error("Ошибка удаления нагрузки.");
            }

            const data = await response.json();

            if (!data || data.success !== true) {
                throw new Error(data && data.message ? data.message : "Ошибка удаления нагрузки.");
            }

            return data;
        }

        document.addEventListener("submit", function (event) {
            const form = event.target.closest(".js-delete-assignment-form");

            if (!form) {
                return;
            }

            event.preventDefault();

            if (form.dataset.deleting === "true") {
                return;
            }

            const chip = form.closest(".js-assigned-chip");
            const modal = form.closest(".js-view-load-modal");
            const lecturerId = form.dataset.lecturerId;
            const hours = parseNumber(form.dataset.hours);
            const submitButton = form.querySelector("button[type='submit']");

            form.dataset.deleting = "true";

            if (submitButton) {
                submitButton.disabled = true;
            }

            deleteAssignment(form)
                .then(function () {
                    updatePageHoursAfterDelete(hours);
                    updateLecturerHoursAfterDelete(lecturerId, hours);
                    updateAddModalAfterDelete(lecturerId, hours);

                    if (modal) {
                        updateViewModalHoursAfterDelete(modal, hours);
                    }

                    if (chip) {
                        cleanupAfterChipDelete(chip);
                    }

                    if (modal) {
                        modal.querySelectorAll(".js-delete-assignment-form").forEach(function (deleteForm) {
                            deleteForm.dataset.deleting = "false";

                            const button = deleteForm.querySelector("button[type='submit']");
                            if (button) {
                                button.disabled = false;
                            }
                        });
                    }

                    applyLecturerFiltersAndSort();
                })
                .catch(function (error) {
                    form.dataset.deleting = "false";

                    if (submitButton) {
                        submitButton.disabled = false;
                    }

                    alert(error.message || "Не удалось удалить нагрузку. Обновите страницу и попробуйте ещё раз.");
                });
        });

        document.addEventListener("submit", function (event) {
            const form = event.target.closest(".js-auto-delete-assignment-form");

            if (!form) {
                return;
            }

            event.preventDefault();

            if (form.dataset.deleting === "true") {
                return;
            }

            const lecturerId = form.dataset.lecturerId;
            const hours = parseNumber(form.dataset.hours);
            const button = form.querySelector("button[type='submit']");
            const pill = form.closest(".js-auto-assignment-row");
            const workTypeRow = form.closest(".js-auto-worktype-row");
            const autoGroup = form.closest(".js-auto-distribution-group");

            form.dataset.deleting = "true";

            if (button) {
                button.disabled = true;
                button.textContent = "…";
            }

            deleteAssignment(form)
                .then(function () {
                    updatePageHoursAfterDelete(hours);
                    updateLecturerHoursAfterDelete(lecturerId, hours);
                    updateAddModalAfterDelete(lecturerId, hours);

                    if (pill) {
                        pill.remove();
                    }

                    if (workTypeRow && workTypeRow.querySelectorAll(".js-auto-assignment-row").length === 0) {
                        workTypeRow.remove();
                    }

                    if (autoGroup) {
                        const oldTotal = parseNumber(autoGroup.dataset.totalHours);
                        const newTotal = Math.max(0, oldTotal - hours);
                        autoGroup.dataset.totalHours = String(newTotal);

                        const totalElement = autoGroup.querySelector(".js-auto-group-total");
                        if (totalElement) {
                            totalElement.textContent = `${formatNumber(newTotal)} ч.`;
                        }

                        if (autoGroup.querySelectorAll(".js-auto-assignment-row").length === 0) {
                            autoGroup.remove();
                        }
                    }

                    applyLecturerFiltersAndSort();
                })
                .catch(function (error) {
                    form.dataset.deleting = "false";

                    if (button) {
                        button.disabled = false;
                        button.textContent = "×";
                    }

                    alert(error.message || "Не удалось удалить нагрузку. Обновите страницу и попробуйте ещё раз.");
                });
        });

        function applyLecturerFiltersAndSort() {
            const container = document.querySelector(".js-lecturers-container");

            if (!container) {
                return;
            }

            const search = (document.querySelector(".js-lecturer-search")?.value || "").toLowerCase().trim();
            const filter = document.querySelector(".js-lecturer-filter")?.value || "all";
            const sort = document.querySelector(".js-lecturer-sort")?.value || "name-asc";

            const cards = Array.from(container.querySelectorAll(".js-lecturer-card"));

            cards.forEach(function (card) {
                const name = card.dataset.name || "";
                const post = card.dataset.post || "";
                const assigned = parseNumber(card.dataset.assigned);
                const assistant = card.dataset.assistant === "true";

                let visible = true;

                if (search && !name.includes(search) && !post.includes(search)) {
                    visible = false;
                }

                if (filter === "with-load" && assigned <= 0) {
                    visible = false;
                }

                if (filter === "without-load" && assigned > 0) {
                    visible = false;
                }

                if (filter === "assistant" && !assistant) {
                    visible = false;
                }

                card.classList.toggle("d-none", !visible);
            });

            cards.sort(function (a, b) {
                const nameA = a.dataset.name || "";
                const nameB = b.dataset.name || "";
                const assignedA = parseNumber(a.dataset.assigned);
                const assignedB = parseNumber(b.dataset.assigned);
                const remainingA = parseNumber(a.dataset.remaining);
                const remainingB = parseNumber(b.dataset.remaining);

                if (sort === "assigned-desc") {
                    return assignedB - assignedA || nameA.localeCompare(nameB);
                }

                if (sort === "assigned-asc") {
                    return assignedA - assignedB || nameA.localeCompare(nameB);
                }

                if (sort === "remaining-desc") {
                    return remainingB - remainingA || nameA.localeCompare(nameB);
                }

                if (sort === "remaining-asc") {
                    return remainingA - remainingB || nameA.localeCompare(nameB);
                }

                return nameA.localeCompare(nameB);
            });

            cards.forEach(function (card) {
                container.appendChild(card);
            });
        }

        document.addEventListener("input", function (event) {
            if (event.target.classList.contains("js-lecturer-search")) {
                applyLecturerFiltersAndSort();
            }
        });

        document.addEventListener("change", function (event) {
            if (event.target.classList.contains("js-lecturer-filter")
                || event.target.classList.contains("js-lecturer-sort")) {
                applyLecturerFiltersAndSort();
            }
        });

        applyLecturerFiltersAndSort();
    </script>

    @if (autoDistributionResult != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const modalElement = document.getElementById("autoDistributionResultModal");

                if (!modalElement || !window.bootstrap) {
                    return;
                }

                function cleanupModalBackdrop() {
                    document.querySelectorAll(".modal-backdrop").forEach(function (backdrop) {
                        backdrop.remove();
                    });

                    document.body.classList.remove("modal-open");
                    document.body.style.removeProperty("overflow");
                    document.body.style.removeProperty("padding-right");
                }

                modalElement.addEventListener("hidden.bs.modal", function () {
                    cleanupModalBackdrop();
                });

                const modal = bootstrap.Modal.getOrCreateInstance(modalElement, {
                    backdrop: true,
                    keyboard: true
                });

                modal.show();

                document.querySelectorAll('[data-bs-target="#autoDistributionResultModal"]').forEach(function (button) {
                    button.addEventListener("click", function () {
                        cleanupModalBackdrop();

                        const modalForOpen = bootstrap.Modal.getOrCreateInstance(modalElement, {
                            backdrop: true,
                            keyboard: true
                        });

                        modalForOpen.show();
                    });
                });
            });
        </script>
    }
}

@functions {
    private static int GetAutoDistributionElementSortOrder(string? elementName)
    {
        if (string.IsNullOrWhiteSpace(elementName))
        {
            return 100;
        }

        var value = elementName.Trim().ToLowerInvariant().Replace("ё", "е");

        return value switch
        {
            "лекции" => 1,
            "консультации" => 2,
            "экзамен" => 3,
            "зачет" => 4,
            "курсовая работа" => 5,
            "курсовой проект" => 6,
            "ргр" => 7,
            _ => 100
        };
    }

    private static string FormatAutoDistributionUnitName(string? unitName)
    {
        if (string.IsNullOrWhiteSpace(unitName))
        {
            return "нагрузка";
        }

        return unitName
            .Replace("гр. ", "", StringComparison.OrdinalIgnoreCase)
            .Replace("поток ", "поток ", StringComparison.OrdinalIgnoreCase)
            .Trim();
    }

    private static bool IsGiaAssignment(string? sourceTypeDisplayName)
    {
        return !string.IsNullOrWhiteSpace(sourceTypeDisplayName)
               && sourceTypeDisplayName.Contains("ГИА", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsAdditionalWorkAssignment(string? sourceTypeDisplayName)
    {
        return !string.IsNullOrWhiteSpace(sourceTypeDisplayName)
               && sourceTypeDisplayName.Contains("Доп. работа", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsAutumnAssignment(string? subtitle)
    {
        if (string.IsNullOrWhiteSpace(subtitle))
        {
            return false;
        }

        return subtitle.Contains("осень", StringComparison.OrdinalIgnoreCase)
               || subtitle.Contains("осен", StringComparison.OrdinalIgnoreCase)
               || subtitle.Contains("1 сем", StringComparison.OrdinalIgnoreCase)
               || subtitle.Contains("1-й сем", StringComparison.OrdinalIgnoreCase)
               || subtitle.Contains("1 семестр", StringComparison.OrdinalIgnoreCase)
               || subtitle.Contains("семестр 1", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsSpringAssignment(string? subtitle)
    {
        if (string.IsNullOrWhiteSpace(subtitle))
        {
            return false;
        }

        return subtitle.Contains("весна", StringComparison.OrdinalIgnoreCase)
               || subtitle.Contains("весен", StringComparison.OrdinalIgnoreCase)
               || subtitle.Contains("2 сем", StringComparison.OrdinalIgnoreCase)
               || subtitle.Contains("2-й сем", StringComparison.OrdinalIgnoreCase)
               || subtitle.Contains("2 семестр", StringComparison.OrdinalIgnoreCase)
               || subtitle.Contains("семестр 2", StringComparison.OrdinalIgnoreCase);
    }

    private sealed class AssignedSubjectGroup
    {
        public string Title { get; set; } = string.Empty;

        public string Subtitle { get; set; } = string.Empty;

        public List<DepartmentLoadApp.ViewModels.WorkloadDistribution.WorkloadDistributionAssignmentViewModel> Items { get; set; } = new();
    }

    private static List<AssignedSubjectGroup> BuildAssignedSubjectGroups(
        IEnumerable<DepartmentLoadApp.ViewModels.WorkloadDistribution.WorkloadDistributionAssignmentViewModel> assignments)
    {
        return assignments
            .GroupBy(BuildAssignedSubjectKey)
            .Select(group =>
            {
                var items = group
                    .OrderBy(x => x.ElementDisplayName)
                    .ThenBy(x => x.UnitName)
                    .ToList();

                return new AssignedSubjectGroup
                    {
                        Title = items.First().Title,
                        Subtitle = BuildAssignedSubjectSubtitle(items),
                        Items = items
                    };
            })
            .OrderBy(x => x.Title)
            .ThenBy(x => x.Subtitle)
            .ToList();
    }

    private static string BuildAssignedSubjectKey(
        DepartmentLoadApp.ViewModels.WorkloadDistribution.WorkloadDistributionAssignmentViewModel item)
    {
        return string.Join("|", new[]
        {
            NormalizeAssignedSubjectKey(item.Title),
            NormalizeAssignedSubjectKey(ExtractAssignedCoursePart(item.Subtitle)),
            NormalizeAssignedSubjectKey(item.SemesterName)
        });
    }

    private static string BuildAssignedSubjectSubtitle(
        IEnumerable<DepartmentLoadApp.ViewModels.WorkloadDistribution.WorkloadDistributionAssignmentViewModel> items)
    {
        var itemList = items.ToList();

        if (itemList.Count == 0)
        {
            return string.Empty;
        }

        var first = itemList[0];

        var directions = itemList
            .SelectMany(x => ExtractAssignedDirectionParts(x.Subtitle))
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();

        var coursePart = ExtractAssignedCoursePart(first.Subtitle);
        var semesterPart = !string.IsNullOrWhiteSpace(first.SemesterName)
            ? first.SemesterName
            : ExtractAssignedSemesterPart(first.Subtitle);

        return string.Join(" · ", new[]
        {
            directions.Count > 0 ? string.Join(", ", directions) : null,
            coursePart,
            semesterPart
        }.Where(x => !string.IsNullOrWhiteSpace(x)));
    }

    private static List<string> ExtractAssignedDirectionParts(string? subtitle)
    {
        if (string.IsNullOrWhiteSpace(subtitle))
        {
            return new List<string>();
        }

        var firstPart = subtitle
            .Split('·', StringSplitOptions.RemoveEmptyEntries)
            .FirstOrDefault();

        if (string.IsNullOrWhiteSpace(firstPart))
        {
            return new List<string>();
        }

        return firstPart
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToList();
    }

    private static string ExtractAssignedCoursePart(string? subtitle)
    {
        if (string.IsNullOrWhiteSpace(subtitle))
        {
            return string.Empty;
        }

        return subtitle
            .Split('·', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .FirstOrDefault(x => x.Contains("курс", StringComparison.OrdinalIgnoreCase))
            ?? string.Empty;
    }

    private static string ExtractAssignedSemesterPart(string? subtitle)
    {
        if (string.IsNullOrWhiteSpace(subtitle))
        {
            return string.Empty;
        }

        return subtitle
            .Split('·', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .LastOrDefault()
            ?? string.Empty;
    }

    private static string NormalizeAssignedSubjectKey(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? string.Empty
            : value.Trim().ToLowerInvariant();
    }
}
