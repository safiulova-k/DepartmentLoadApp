@model List<DepartmentLoadApp.ViewModels.WorkloadDistributionRowViewModel>

@{
    ViewData["Title"] = "Распределение нагрузки";
}

<div class="row mb-4">
    <div class="col-12">
        <h2>Распределение нагрузки между преподавателями</h2>
        <p class="text-muted">
            Ручное распределение рассчитанных часов между преподавателями кафедры.
        </p>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">

                <thead class="table-header">
                    <tr>
                        <th>Дисциплина</th>
                        <th>Группа</th>
                        <th>Всего часов</th>
                        <th>Преподаватель</th>
                        <th>Назначено часов</th>
                    </tr>
                </thead>

                <tbody>

                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr>

                            <td>
                                @Model[i].DisciplineName
                            </td>

                            <td>
                                @Model[i].GroupName
                            </td>

                            <td>
                                @Model[i].TotalHours
                            </td>

                            <td>
                                <input class="form-control"
                                       value="@Model[i].LecturerName" />
                            </td>

                            <td>
                                <input class="form-control"
                                       type="number"
                                       value="@Model[i].AssignedHours" />
                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        </div>

        <div class="mt-3">

            <button class="btn btn-primary">
                Сохранить распределение
            </button>

        </div>

    </div>
</div>