@model DepartmentLoadApp.ViewModels.WorkloadDistribution.WorkloadDistributionPageViewModel
@using DepartmentLoadApp.ViewModels.WorkloadDistribution

@{
    ViewData["Title"] = "Распределение нагрузки";

    var autoDistributionResult = ViewData["AutoDistributionResult"] as AutoDistributionResultViewModel;
}

<style>
    .distribution-summary-card {
        min-height: 72px;
    }

        .distribution-summary-card .card-body {
            padding: 10px 14px;
        }

        .distribution-summary-card .fs-3 {
            font-size: 1.45rem !important;
        }

    .distribution-current-year-line {
        width: 100%;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        background: #f8f9fa;
        padding: 10px 14px;
        margin-bottom: 14px;
        font-size: 1.08rem;
        font-weight: 600;
    }

    .distribution-toolbar {
        display: grid;
        grid-template-columns: minmax(320px, 1fr) 230px 230px;
        gap: 12px;
        align-items: end;
        margin-bottom: 18px;
    }

    .distribution-modal .modal-dialog,
    .distribution-view-modal .modal-dialog {
        max-width: 1200px;
        height: calc(100vh - 32px);
        margin: 16px auto;
    }

    .distribution-modal .modal-content,
    .distribution-view-modal .modal-content {
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .distribution-modal form {
        height: 100%;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    .distribution-modal .modal-header,
    .distribution-view-modal .modal-header {
        flex: 0 0 auto;
        background: #fff;
        border-bottom: 1px solid #dee2e6;
        padding: 12px 16px;
        align-items: flex-start;
    }

    .distribution-modal .modal-body,
    .distribution-view-modal .modal-body {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        padding: 12px 16px;
    }

    .distribution-modal .modal-footer,
    .distribution-view-modal .modal-footer {
        flex: 0 0 auto;
        background: #fff;
        border-top: 1px solid #dee2e6;
    }

    .distribution-modal-header-wrap {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        width: 100%;
        padding-right: 32px;
    }

    .distribution-modal-header-left {
        min-width: 260px;
    }

    .distribution-modal-title {
        font-size: 1.15rem;
        font-weight: 600;
        line-height: 1.2;
        margin-bottom: 2px;
    }

    .distribution-modal-subtitle {
        font-size: 0.9rem;
        color: #6c757d;
    }

    .distribution-modal-header-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: flex-end;
        align-items: stretch;
    }

    .distribution-mini-stat {
        min-width: 118px;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 6px 10px;
        background: #f8f9fa;
    }

    .distribution-mini-stat-label {
        font-size: 0.75rem;
        color: #6c757d;
        line-height: 1.1;
        margin-bottom: 2px;
    }

    .distribution-mini-stat-value {
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.1;
    }

    .distribution-modal-footer-warning {
        margin-right: auto;
        color: #dc3545;
        font-weight: 600;
    }

    .distribution-worktype-row {
        display: grid;
        grid-template-columns: 180px 1fr;
        gap: 10px;
        align-items: start;
        padding: 8px 0;
        border-top: 1px dashed #e9ecef;
    }

        .distribution-worktype-row:first-child {
            border-top: none;
            padding-top: 0;
        }

    .distribution-worktype-title {
        font-weight: 600;
        color: #0d6efd;
        font-size: 0.95rem;
        padding-top: 6px;
    }

        .distribution-worktype-title .btn-link {
            font-size: 12px;
            text-decoration: none;
        }

            .distribution-worktype-title .btn-link:hover {
                text-decoration: underline;
            }

    .distribution-chip-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .distribution-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid #ced4da;
        border-radius: 999px;
        padding: 8px 12px;
        cursor: pointer;
        background: #fff;
        transition: all .15s ease-in-out;
        user-select: none;
        margin: 0;
    }

        .distribution-chip:hover {
            border-color: #86b7fe;
            background: #f8fbff;
        }

        .distribution-chip.selected {
            border-color: #0d6efd;
            background: #eaf3ff;
            box-shadow: inset 0 0 0 1px #0d6efd;
        }

        .distribution-chip input[type="checkbox"] {
            margin: 0;
            flex: 0 0 auto;
        }

    .distribution-chip-main {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
    }

    .distribution-chip-title {
        font-size: 0.95rem;
    }

    .distribution-chip-meta {
        font-size: 0.82rem;
        color: #6c757d;
        white-space: nowrap;
    }

    .distribution-gia-row {
        border-top: 1px solid #e9ecef;
        padding: 12px 0;
    }

        .distribution-gia-row:first-child {
            border-top: none;
            padding-top: 0;
        }

    .distribution-gia-title {
        font-weight: 600;
    }

    .distribution-gia-subtitle,
    .distribution-gia-meta {
        font-size: 0.9rem;
        color: #6c757d;
    }

    .distribution-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .distribution-assigned-chip {
        cursor: default;
        padding-right: 8px;
    }

        .distribution-assigned-chip .btn {
            border-radius: 999px;
            padding: 1px 7px;
            line-height: 1.2;
            font-size: 0.78rem;
        }

    .distribution-empty-section {
        margin-bottom: 0;
    }

    .distribution-additional-list {
        display: flex;
        flex-direction: column;
    }

    .distribution-additional-row {
        display: grid;
        grid-template-columns: minmax(340px, 1fr) 340px 140px;
        gap: 24px;
        align-items: center;
        padding: 18px 0;
        border-bottom: 1px solid #e9ecef;
    }

        .distribution-additional-row:last-child {
            border-bottom: none;
        }

    .distribution-additional-title {
        font-weight: 600;
        font-size: 1rem;
        margin-bottom: 4px;
    }

    .distribution-additional-meta {
        color: #6c757d;
        font-size: 0.92rem;
        line-height: 1.45;
    }

    .distribution-additional-input-block label {
        font-size: 0.88rem;
        color: #495057;
        margin-bottom: 6px;
    }

    .distribution-additional-hours-label {
        font-size: 0.88rem;
        color: #6c757d;
        margin-bottom: 4px;
    }

    .distribution-additional-hours-value {
        font-weight: 600;
        font-size: 1rem;
    }

    .distribution-view-additional-list {
        display: flex;
        flex-direction: column;
    }

    .distribution-view-additional-row {
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: 18px;
        align-items: flex-start;
        padding: 14px 0;
        border-bottom: 1px dashed #e9ecef;
    }

        .distribution-view-additional-row:last-child {
            border-bottom: none;
        }

    .distribution-view-additional-title {
        font-weight: 600;
        color: #0d6efd;
        line-height: 1.35;
    }

    .auto-distribution-modal .modal-body {
        background: #f8f9fa;
    }

    .auto-distribution-item {
        border: 1px solid #e2e6ea;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 10px;
        background: #ffffff;
    }

        .auto-distribution-item .accordion-button {
            background: #ffffff;
            box-shadow: none;
        }

            .auto-distribution-item .accordion-button:not(.collapsed) {
                background: #f3f7ff;
            }

    .auto-distribution-total {
        min-width: 64px;
        font-size: 0.9rem;
    }

    .auto-distribution-work-row {
        display: grid;
        grid-template-columns: 170px 1fr;
        gap: 12px;
        align-items: flex-start;
        padding: 8px 0;
        border-bottom: 1px solid #eef0f2;
    }

        .auto-distribution-work-row:last-child {
            border-bottom: 0;
        }

    .auto-distribution-work-title {
        font-weight: 600;
        padding-top: 5px;
    }

    .auto-distribution-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .auto-distribution-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid #cfe2ff;
        background: #eef5ff;
        color: #1f3f68;
        border-radius: 999px;
        padding: 5px 8px 5px 12px;
        font-size: 0.92rem;
    }

    .auto-distribution-pill-text {
        white-space: nowrap;
    }

    .auto-distribution-delete-form {
        display: inline-flex;
        margin: 0;
    }

    .auto-distribution-pill-delete {
        width: 22px;
        height: 22px;
        border: 0;
        border-radius: 50%;
        background: #ffffff;
        color: #dc3545;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        font-weight: 700;
        padding: 0;
    }

        .auto-distribution-pill-delete:hover {
            background: #dc3545;
            color: #ffffff;
        }

    @@media (max-width: 991.98px) {
        .distribution-toolbar {
            grid-template-columns: 1fr;
        }

        .distribution-worktype-row {
            grid-template-columns: 1fr;
        }

        .distribution-worktype-title {
            padding-top: 0;
        }

        .distribution-modal-header-wrap {
            flex-direction: column;
            padding-right: 24px;
        }

        .distribution-modal-header-stats {
            width: 100%;
            justify-content: flex-start;
        }

        .distribution-mini-stat {
            min-width: 105px;
        }

        .distribution-additional-row {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .distribution-view-additional-row {
            grid-template-columns: 1fr;
        }

        .auto-distribution-work-row {
            grid-template-columns: 1fr;
            gap: 6px;
        }

        .auto-distribution-pill-text {
            white-space: normal;
        }
    }
</style>

<h1>Распределение нагрузки</h1>

<div class="distribution-current-year-line">
    Текущий учебный год: @Model.SelectedYear
</div>


<div class="d-flex flex-wrap gap-2 mb-3">
    <form asp-action="AutoDistribute" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="SelectedYearStart" value="@Model.SelectedYearStart" />
        <input type="hidden" name="SelectedLecturerId" value="@Model.SelectedLecturerId" />

        <button type="submit" class="btn btn-success">
            Распределить автоматически
        </button>
    </form>

    <form asp-action="ClearDistribution"
          method="post"
          onsubmit="return confirm('Удалить все распределения за текущий учебный год?');">
        @Html.AntiForgeryToken()

        <input type="hidden" name="SelectedYearStart" value="@Model.SelectedYearStart" />
        <input type="hidden" name="SelectedLecturerId" value="@Model.SelectedLecturerId" />

        <button type="submit" class="btn btn-outline-danger">
            Очистить распределения
        </button>
    </form>

    @if (autoDistributionResult != null)
    {
        <button type="button"
                class="btn btn-outline-primary"
                data-bs-toggle="modal"
                data-bs-target="#autoDistributionResultModal">
            Показать результат автораспределения
        </button>
    }
</div>

<div class="distribution-toolbar">
    <div>
        <label class="form-label">Поиск преподавателя</label>
        <input type="text"
               class="form-control form-control-sm js-lecturer-search"
               placeholder="Введите ФИО или должность" />
    </div>

    <div>
        <label class="form-label">Фильтр</label>
        <select class="form-select form-select-sm js-lecturer-filter">
            <option value="all">Все преподаватели</option>
            <option value="with-load">С назначенной нагрузкой</option>
            <option value="without-load">Без нагрузки</option>
            <option value="assistant">Ассистенты</option>
        </select>
    </div>

    <div>
        <label class="form-label">Сортировка</label>
        <select class="form-select form-select-sm js-lecturer-sort">
            <option value="name-asc">По ФИО</option>
            <option value="assigned-desc">Больше назначено</option>
            <option value="assigned-asc">Меньше назначено</option>
            <option value="remaining-desc">Больше остаток</option>
            <option value="remaining-asc">Меньше остаток</option>
        </select>
    </div>
</div>

@if (TempData["SuccessMessage"] != null || ViewData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @(TempData["SuccessMessage"] ?? ViewData["SuccessMessage"])
    </div>
}

@if (TempData["ErrorMessage"] != null || ViewData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @(TempData["ErrorMessage"] ?? ViewData["ErrorMessage"])
    </div>
}

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <div class="card shadow-sm distribution-summary-card">
            <div class="card-body">
                <div class="text-muted small">Всего нагрузки</div>
                <div class="fs-3 fw-semibold">@Model.TotalHours.ToString("0") ч.</div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm distribution-summary-card">
            <div class="card-body">
                <div class="text-muted small">Назначено</div>
                <div class="fs-3 fw-semibold">
                    <span class="js-page-assigned-hours"
                          data-value="@Model.AssignedHours.ToString("0.####").Replace(",", ".")">
                        @Model.AssignedHours.ToString("0")
                    </span> ч.
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm distribution-summary-card">
            <div class="card-body">
                <div class="text-muted small">Осталось</div>
                <div class="fs-3 fw-semibold">
                    <span class="js-page-remaining-hours"
                          data-value="@Model.RemainingHours.ToString("0.####").Replace(",", ".")">
                        @Model.RemainingHours.ToString("0")
                    </span> ч.
                </div>
            </div>
        </div>
    </div>
</div>

@if (!Model.Lecturers.Any())
{
    <div class="alert alert-info">
        Нет преподавателей для распределения нагрузки.
    </div>
}
else
{
    <div class="accordion js-lecturers-container" id="lecturersAccordion">
        @for (var i = 0; i < Model.Lecturers.Count; i++)
        {
            var lecturer = Model.Lecturers[i];
            var lecturerCollapseId = $"lecturer_{lecturer.LecturerId}";
            var modalId = $"loadModal_{lecturer.LecturerId}";
            var viewModalId = $"viewLoadModal_{lecturer.LecturerId}";

            var autumnAssignments = lecturer.Assignments
            .Where(x => !IsGiaAssignment(x.SourceTypeDisplayName))
            .Where(x => !IsAdditionalWorkAssignment(x.SourceTypeDisplayName))
            .Where(x => IsAutumnAssignment(x.Subtitle))
            .OrderBy(x => x.Title)
            .ThenBy(x => x.ElementDisplayName)
            .ThenBy(x => x.UnitName)
            .ToList();

            var springAssignments = lecturer.Assignments
            .Where(x => !IsGiaAssignment(x.SourceTypeDisplayName))
            .Where(x => !IsAdditionalWorkAssignment(x.SourceTypeDisplayName))
            .Where(x => IsSpringAssignment(x.Subtitle))
            .OrderBy(x => x.Title)
            .ThenBy(x => x.ElementDisplayName)
            .ThenBy(x => x.UnitName)
            .ToList();

            var otherAssignments = lecturer.Assignments
            .Where(x => !IsGiaAssignment(x.SourceTypeDisplayName))
            .Where(x => !IsAdditionalWorkAssignment(x.SourceTypeDisplayName))
            .Where(x => !autumnAssignments.Any(a => a.AssignmentId == x.AssignmentId))
            .Where(x => !springAssignments.Any(a => a.AssignmentId == x.AssignmentId))
            .OrderBy(x => x.Title)
            .ThenBy(x => x.ElementDisplayName)
            .ThenBy(x => x.UnitName)
            .ToList();

            var giaAssignments = lecturer.Assignments
            .Where(x => IsGiaAssignment(x.SourceTypeDisplayName))
            .OrderBy(x => x.Title)
            .ThenBy(x => x.ElementDisplayName)
            .ThenBy(x => x.UnitName)
            .ToList();

            var additionalAssignments = lecturer.Assignments
            .Where(x => IsAdditionalWorkAssignment(x.SourceTypeDisplayName))
            .OrderBy(x => x.Title)
            .ThenBy(x => x.ElementDisplayName)
            .ThenBy(x => x.UnitName)
            .ToList();

            var autumnSubjectGroups = BuildAssignedSubjectGroups(autumnAssignments);
            var springSubjectGroups = BuildAssignedSubjectGroups(springAssignments.Concat(otherAssignments));
            var giaSubjectGroups = BuildAssignedSubjectGroups(giaAssignments);

            var additionalWorkTypeGroups = additionalAssignments
            .GroupBy(x => x.ElementDisplayName)
            .OrderBy(x => x.Key)
            .ToList();

            var autumnSectionId = $"viewAutumn_{lecturer.LecturerId}";
            var springSectionId = $"viewSpring_{lecturer.LecturerId}";
            var giaSectionId = $"viewGia_{lecturer.LecturerId}";
            var additionalSectionId = $"viewAdditional_{lecturer.LecturerId}";

            <div class="accordion-item mb-2 border rounded js-lecturer-card"
                 data-lecturer-id="@lecturer.LecturerId"
                 data-name="@((lecturer.LecturerDisplayName ?? string.Empty).ToLower())"
                 data-post="@((lecturer.LecturerStudyPostTitle ?? string.Empty).ToLower())"
                 data-assigned="@lecturer.AssignedHours.ToString("0.####").Replace(",", ".")"
                 data-remaining="@lecturer.RemainingHours.ToString("0.####").Replace(",", ".")"
                 data-overloaded="@(lecturer.IsOverloaded ? "true" : "false")"
                 data-assistant="@(lecturer.IsAssistant ? "true" : "false")">

                <h2 class="accordion-header">
                    <button class="accordion-button collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#@lecturerCollapseId">
                        <div class="d-flex justify-content-between align-items-center w-100 pe-3 flex-wrap gap-2">
                            <div>
                                <div class="fw-semibold">@lecturer.LecturerDisplayName</div>
                                <div class="small text-muted">
                                    @lecturer.LecturerStudyPostTitle · ставка по договору
                                    <span class="js-rate-label" data-lecturer-id="@lecturer.LecturerId">
                                        @lecturer.Rate.ToString("0.##")
                                    </span>
                                    · норма
                                    <span class="js-effective-norm"
                                          data-lecturer-id="@lecturer.LecturerId"
                                          data-norm-hours="@lecturer.NormHours"
                                          data-assigned-hours="@lecturer.AssignedHours.ToString("0.####").Replace(",", ".")">
                                        @lecturer.LimitHours.ToString("0")
                                    </span>
                                </div>
                            </div>

                            <div class="distribution-badges">
                                <span class="badge bg-secondary">
                                    Назначено:
                                    <span class="js-lecturer-assigned-badge"
                                          data-lecturer-id="@lecturer.LecturerId"
                                          data-value="@lecturer.AssignedHours.ToString("0.####").Replace(",", ".")">
                                        @lecturer.AssignedHours.ToString("0")
                                    </span>
                                </span>

                                <span class="badge bg-dark">
                                    Лимит:
                                    <span class="js-limit-badge" data-lecturer-id="@lecturer.LecturerId">
                                        @lecturer.LimitHours.ToString("0")
                                    </span>
                                </span>

                                <span class="badge @(lecturer.RemainingHours < 0 ? "bg-danger" : "bg-success") js-remaining-badge-wrapper"
                                      data-lecturer-id="@lecturer.LecturerId">
                                    Остаток:
                                    <span class="js-remaining-badge"
                                          data-lecturer-id="@lecturer.LecturerId"
                                          data-value="@lecturer.RemainingHours.ToString("0.####").Replace(",", ".")">
                                        @lecturer.RemainingHours.ToString("0")
                                    </span>
                                </span>

                                @if (lecturer.IsAssistant)
                                {
                                    <span class="badge bg-warning text-dark">Ассистент</span>
                                }
                            </div>
                        </div>
                    </button>
                </h2>

                <div id="@lecturerCollapseId"
                     class="accordion-collapse collapse"
                     data-bs-parent="#lecturersAccordion">
                    <div class="accordion-body">
                        <form asp-action="SaveLecturerPlan" method="post" class="row g-2 align-items-end mb-3">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="SelectedYearStart" value="@Model.SelectedYearStart" />
                            <input type="hidden" name="SelectedLecturerId" value="@lecturer.LecturerId" />
                            <input type="hidden" name="LecturerId" value="@lecturer.LecturerId" />

                            <div class="col-md-4">
                                <label class="form-label">Должность</label>
                                <select name="LecturerStudyPostId" class="form-select form-select-sm">
                                    <option value="">Выберите должность</option>
                                    @foreach (var post in Model.StudyPosts)
                                    {
                                        if (post.Id == lecturer.LecturerStudyPostId)
                                        {
                                            <option value="@post.Id" selected>@post.Title — @post.NormHours ч.</option>
                                        }
                                        else
                                        {
                                            <option value="@post.Id">@post.Title — @post.NormHours ч.</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Ставка по договору</label>
                                <select name="Rate"
                                        class="form-select form-select-sm js-rate-select"
                                        data-lecturer-id="@lecturer.LecturerId"
                                        data-norm-hours="@lecturer.NormHours"
                                        data-assigned-hours="@lecturer.AssignedHours.ToString("0.####").Replace(",", ".")">
                                    @if (lecturer.Rate == 0.25m)
                                    {
                                        <option value="0.25" selected>0,25</option>
                                    }
                                    else
                                    {
                                        <option value="0.25">0,25</option>
                                    }

                                    @if (lecturer.Rate == 0.5m)
                                    {
                                        <option value="0.5" selected>0,5</option>
                                    }
                                    else
                                    {
                                        <option value="0.5">0,5</option>
                                    }

                                    @if (lecturer.Rate == 1m)
                                    {
                                        <option value="1" selected>1</option>
                                    }
                                    else
                                    {
                                        <option value="1">1</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-2">
                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                    Сохранить
                                </button>
                            </div>

                            <div class="col-md-3 text-md-end">
                                <button type="button"
                                        class="btn btn-sm btn-success"
                                        data-bs-toggle="modal"
                                        data-bs-target="#@modalId">
                                    Добавить нагрузку
                                </button>

                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary ms-1"
                                        data-bs-toggle="modal"
                                        data-bs-target="#@viewModalId">
                                    Просмотр нагрузки
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="modal fade distribution-modal js-load-modal"
                 id="@modalId"
                 tabindex="-1"
                 data-remaining-hours="@Math.Max(0, lecturer.RemainingHours).ToString("0.####").Replace(",", ".")">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content">
                        <form asp-action="AddSelectedAssignments" method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="SelectedYearStart" value="@Model.SelectedYearStart" />
                            <input type="hidden" name="SelectedLecturerId" value="@lecturer.LecturerId" />
                            <input type="hidden" name="LecturerId" value="@lecturer.LecturerId" />

                            <div class="modal-header">
                                <div class="distribution-modal-header-wrap">
                                    <div class="distribution-modal-header-left">
                                        <div class="distribution-modal-title">
                                            Добавить нагрузку: @lecturer.LecturerDisplayName
                                        </div>
                                        <div class="distribution-modal-subtitle">
                                            @lecturer.LecturerStudyPostTitle
                                        </div>
                                    </div>

                                    <div class="distribution-modal-header-stats">
                                        <div class="distribution-mini-stat">
                                            <div class="distribution-mini-stat-label">Свободно</div>
                                            <div class="distribution-mini-stat-value">
                                                <span class="js-free-hours">@Math.Max(0, lecturer.RemainingHours).ToString("0")</span> ч.
                                            </div>
                                        </div>

                                        <div class="distribution-mini-stat">
                                            <div class="distribution-mini-stat-label">Выбрано</div>
                                            <div class="distribution-mini-stat-value">
                                                <span class="js-selected-hours">0</span> ч.
                                            </div>
                                        </div>

                                        <div class="distribution-mini-stat">
                                            <div class="distribution-mini-stat-label">Останется</div>
                                            <div class="distribution-mini-stat-value">
                                                <span class="js-after-assign-hours">@Math.Max(0, lecturer.RemainingHours).ToString("0")</span> ч.
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>

                            <div class="modal-body">
                                @if (!lecturer.SemesterGroups.Any()
                               && !lecturer.GiaItems.Any()
                               && !lecturer.AdditionalWorkItems.Any())
                                {
                                    <div class="alert alert-info">
                                        Нет свободных элементов нагрузки для назначения.
                                    </div>
                                }
                                else
                                {
                                    <div class="accordion" id="loadAccordion_@lecturer.LecturerId">
                                        @for (var semesterIndex = 0; semesterIndex < lecturer.SemesterGroups.Count; semesterIndex++)
                                        {
                                            var semester = lecturer.SemesterGroups[semesterIndex];
                                            var semesterId = $"semester_{lecturer.LecturerId}_{semesterIndex}";

                                            <div class="accordion-item mb-2">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button collapsed"
                                                            type="button"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#@semesterId">
                                                        @semester.SemesterName
                                                    </button>
                                                </h2>

                                                <div id="@semesterId" class="accordion-collapse collapse">
                                                    <div class="accordion-body">
                                                        <div class="accordion" id="disciplineAccordion_@lecturer.LecturerId@semesterIndex">
                                                            @for (var disciplineIndex = 0; disciplineIndex < semester.Disciplines.Count; disciplineIndex++)
                                                            {
                                                                var discipline = semester.Disciplines[disciplineIndex];
                                                                var disciplineId = $"discipline_{lecturer.LecturerId}_{semesterIndex}_{disciplineIndex}";

                                                                <div class="accordion-item mb-2">
                                                                    <h2 class="accordion-header">
                                                                        <button class="accordion-button collapsed"
                                                                                type="button"
                                                                                data-bs-toggle="collapse"
                                                                                data-bs-target="#@disciplineId">
                                                                            <div>
                                                                                <div>@discipline.Title</div>
                                                                                <div class="small text-muted">@discipline.Subtitle</div>
                                                                            </div>
                                                                        </button>
                                                                    </h2>

                                                                    <div id="@disciplineId" class="accordion-collapse collapse">
                                                                        <div class="accordion-body">
                                                                            @foreach (var workType in discipline.WorkTypes)
                                                                            {
                                                                                <div class="distribution-worktype-row js-worktype-load-block">
                                                                                    <div class="distribution-worktype-title">
                                                                                        <div>@workType.ElementDisplayName:</div>

                                                                                        <button type="button"
                                                                                                class="btn btn-link btn-sm p-0 mt-1 js-select-current-worktype">
                                                                                            Выбрать все
                                                                                        </button>
                                                                                    </div>

                                                                                    <div class="distribution-chip-list">
                                                                                        @foreach (var item in workType.Items)
                                                                                        {
                                                                                            <label class="distribution-chip distribution-available-chip js-load-chip">
                                                                                                <input type="checkbox"
                                                                                                       name="SelectedItemKeys"
                                                                                                       value="@item.ItemKey"
                                                                                                       class="form-check-input js-load-item-checkbox"
                                                                                                       data-hours="@item.RemainingHours.ToString("0.####").Replace(",", ".")" />

                                                                                                <span class="distribution-chip-main">
                                                                                                    <span class="distribution-chip-title">
                                                                                                        @(string.IsNullOrWhiteSpace(item.UnitName)
                                                                                                            ? item.ElementDisplayName
                                                                                                            : item.UnitName)
                                                                                                    </span>

                                                                                                    <span class="distribution-chip-meta">
                                                                                                        @item.RemainingHours.ToString("0.##") ч.
                                                                                                        @if (item.StudentsCount > 0)
                                                                                                        {
                                                                                                            <span> · @item.StudentsCount студ.</span>
                                                                                                        }
                                                                                                    </span>
                                                                                                </span>
                                                                                            </label>
                                                                                        }
                                                                                    </div>
                                                                                </div>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        @if (lecturer.GiaItems.Any())
                                        {
                                            var giaCollapseId = $"gia_{lecturer.LecturerId}";

                                            <div class="accordion-item">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button collapsed"
                                                            type="button"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#@giaCollapseId">
                                                        ГИА
                                                    </button>
                                                </h2>

                                                <div id="@giaCollapseId" class="accordion-collapse collapse">
                                                    <div class="accordion-body">
                                                        @{
                                                            var giaIndex = 0;
                                                        }

                                                        @foreach (var giaItem in lecturer.GiaItems)
                                                        {
                                                            <div class="distribution-gia-row row g-3 align-items-center">
                                                                <div class="col-md-6">
                                                                    <div class="distribution-gia-title">@giaItem.Title</div>
                                                                    <div>@giaItem.ElementDisplayName</div>
                                                                    <div class="distribution-gia-subtitle">@giaItem.Subtitle</div>
                                                                    <div class="distribution-gia-meta">
                                                                        Осталось студентов: @giaItem.RemainingStudentsCount,
                                                                        часов на студента: @giaItem.HoursPerStudent.ToString("0.##")
                                                                    </div>
                                                                </div>

                                                                <div class="col-md-3">
                                                                    <input type="hidden"
                                                                           name="GiaStudents[@giaIndex].ItemKey"
                                                                           value="@giaItem.ItemKey" />

                                                                    <label class="form-label small">Назначить студентов</label>
                                                                    <input type="number"
                                                                           name="GiaStudents[@giaIndex].StudentsCount"
                                                                           value="0"
                                                                           min="0"
                                                                           max="@giaItem.RemainingStudentsCount"
                                                                           class="form-control form-control-sm js-gia-students-input"
                                                                           data-hours-per-student="@giaItem.HoursPerStudent.ToString("0.####").Replace(",", ".")" />
                                                                </div>

                                                                <div class="col-md-3">
                                                                    <div class="small text-muted">Часы</div>
                                                                    <div class="fw-semibold">
                                                                        <span class="js-gia-row-hours">0</span> ч.
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            giaIndex++;
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        @if (lecturer.AdditionalWorkItems.Any())
                                        {
                                            var additionalCollapseId = $"additional_{lecturer.LecturerId}";
                                            var additionalIndex = 0;

                                            <div class="accordion-item">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button collapsed"
                                                            type="button"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#@additionalCollapseId">
                                                        Доп. работа
                                                    </button>
                                                </h2>

                                                <div id="@additionalCollapseId" class="accordion-collapse collapse">
                                                    <div class="accordion-body">
                                                        <div class="distribution-additional-list">
                                                            @foreach (var item in lecturer.AdditionalWorkItems)
                                                            {
                                                                var isPostgraduate = item.RemainingStudentsCount > 0 && item.HoursPerStudent > 0;

                                                                <div class="distribution-additional-row distribution-gia-row">
                                                                    <div>
                                                                        <div class="distribution-additional-title">
                                                                            @item.ElementDisplayName
                                                                        </div>

                                                                        @if (isPostgraduate)
                                                                        {
                                                                            <div class="distribution-additional-meta">
                                                                                Всего аспирантов: @item.StudentsCount,
                                                                                осталось: @item.RemainingStudentsCount
                                                                            </div>
                                                                            <div class="distribution-additional-meta">
                                                                                Норма: @item.HoursPerStudent.ToString("0.##") ч. на аспиранта
                                                                            </div>
                                                                        }
                                                                        else
                                                                        {
                                                                            <div class="distribution-additional-meta">
                                                                                Доступно часов: @item.TotalHours.ToString("0.##")
                                                                            </div>
                                                                            <div class="distribution-additional-meta">
                                                                                Осталось часов: @item.RemainingHours.ToString("0.##")
                                                                            </div>
                                                                        }
                                                                    </div>

                                                                    <div class="distribution-additional-input-block">
                                                                        <input type="hidden"
                                                                               name="AdditionalWorks[@additionalIndex].ItemKey"
                                                                               value="@item.ItemKey" />

                                                                        @if (isPostgraduate)
                                                                        {
                                                                            <label class="form-label">Назначить аспирантов</label>

                                                                            <input type="number"
                                                                                   name="AdditionalWorks[@additionalIndex].StudentsCount"
                                                                                   value="0"
                                                                                   min="0"
                                                                                   max="@item.RemainingStudentsCount"
                                                                                   class="form-control form-control-sm js-additional-students-input"
                                                                                   data-hours-per-student="@item.HoursPerStudent.ToString("0.####").Replace(",", ".")" />

                                                                            <input type="hidden"
                                                                                   name="AdditionalWorks[@additionalIndex].Hours"
                                                                                   value="0" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <label class="form-label">Назначить часов</label>

                                                                            <input type="number"
                                                                                   name="AdditionalWorks[@additionalIndex].Hours"
                                                                                   value="0"
                                                                                   min="0"
                                                                                   max="@item.RemainingHours.ToString("0.####").Replace(",", ".")"
                                                                                   step="0.01"
                                                                                   class="form-control form-control-sm js-additional-hours-input" />

                                                                            <input type="hidden"
                                                                                   name="AdditionalWorks[@additionalIndex].StudentsCount"
                                                                                   value="0" />
                                                                        }
                                                                    </div>

                                                                    <div>
                                                                        <div class="distribution-additional-hours-label">Часы</div>
                                                                        <div class="distribution-additional-hours-value">
                                                                            <span class="js-additional-row-hours">0</span> ч.
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                additionalIndex++;
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="modal-footer">
                                <div class="distribution-modal-footer-warning d-none js-limit-warning">
                                    Превышен лимит преподавателя.
                                </div>

                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                    Закрыть
                                </button>

                                <button type="submit" class="btn btn-primary js-assign-selected-button">
                                    Назначить выбранное
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="modal fade distribution-view-modal js-view-load-modal"
                 id="@viewModalId"
                 tabindex="-1"
                 data-lecturer-id="@lecturer.LecturerId"
                 data-limit-hours="@lecturer.LimitHours.ToString("0.####").Replace(",", ".")">
