@model DepartmentLoadApp.ViewModels.WorkloadDistribution.WorkloadDistributionPageViewModel

@{
    ViewData["Title"] = "Распределение нагрузки";

    var currentAcademicStartYear = DateTime.Now.Month >= 9
        ? DateTime.Now.Year
        : DateTime.Now.Year - 1;

    var maxAvailableStartYear = currentAcademicStartYear + 1;

    var availableYearStarts = Model.AvailableYearStarts
        .Where(x => x <= maxAvailableStartYear)
        .OrderByDescending(x => x)
        .ToList();
}

<style>
    .distribution-summary-card {
        min-height: 72px;
    }

        .distribution-summary-card .card-body {
            padding: 10px 14px;
        }

        .distribution-summary-card .fs-3 {
            font-size: 1.45rem !important;
        }

    .distribution-toolbar {
        display: grid;
        grid-template-columns: 170px minmax(240px, 1fr) 210px 210px;
        gap: 12px;
        align-items: end;
        margin-bottom: 18px;
    }

    .distribution-modal .modal-dialog,
    .distribution-view-modal .modal-dialog {
        max-width: 1200px;
        height: calc(100vh - 32px);
        margin: 16px auto;
    }

    .distribution-modal .modal-content,
    .distribution-view-modal .modal-content {
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .distribution-modal form {
        height: 100%;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    .distribution-modal .modal-header,
    .distribution-view-modal .modal-header {
        flex: 0 0 auto;
        background: #fff;
        border-bottom: 1px solid #dee2e6;
        padding: 12px 16px;
        align-items: flex-start;
    }

    .distribution-modal .modal-body,
    .distribution-view-modal .modal-body {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        padding: 12px 16px;
    }

    .distribution-modal .modal-footer,
    .distribution-view-modal .modal-footer {
        flex: 0 0 auto;
        background: #fff;
        border-top: 1px solid #dee2e6;
    }

    .distribution-modal-header-wrap {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        width: 100%;
        padding-right: 32px;
    }

    .distribution-modal-header-left {
        min-width: 260px;
    }

    .distribution-modal-title {
        font-size: 1.15rem;
        font-weight: 600;
        line-height: 1.2;
        margin-bottom: 2px;
    }

    .distribution-modal-subtitle {
        font-size: 0.9rem;
        color: #6c757d;
    }

    .distribution-modal-header-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: flex-end;
        align-items: stretch;
    }

    .distribution-mini-stat {
        min-width: 118px;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 6px 10px;
        background: #f8f9fa;
    }

    .distribution-mini-stat-label {
        font-size: 0.75rem;
        color: #6c757d;
        line-height: 1.1;
        margin-bottom: 2px;
    }

    .distribution-mini-stat-value {
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.1;
    }

    .distribution-modal-footer-warning {
        margin-right: auto;
        color: #dc3545;
        font-weight: 600;
    }

    .distribution-worktype-row {
        display: grid;
        grid-template-columns: 180px 1fr;
        gap: 10px;
        align-items: start;
        padding: 8px 0;
        border-top: 1px dashed #e9ecef;
    }

        .distribution-worktype-row:first-child {
            border-top: none;
            padding-top: 0;
        }

    .distribution-worktype-title {
        font-weight: 600;
        color: #0d6efd;
        font-size: 0.95rem;
        padding-top: 6px;
    }

    .distribution-chip-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .distribution-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid #ced4da;
        border-radius: 999px;
        padding: 8px 12px;
        cursor: pointer;
        background: #fff;
        transition: all .15s ease-in-out;
        user-select: none;
        margin: 0;
    }

        .distribution-chip:hover {
            border-color: #86b7fe;
            background: #f8fbff;
        }

        .distribution-chip.selected {
            border-color: #0d6efd;
            background: #eaf3ff;
            box-shadow: inset 0 0 0 1px #0d6efd;
        }

        .distribution-chip input[type="checkbox"] {
            margin: 0;
            flex: 0 0 auto;
        }

    .distribution-chip-main {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
    }

    .distribution-chip-title {
        font-size: 0.95rem;
    }

    .distribution-chip-meta {
        font-size: 0.82rem;
        color: #6c757d;
        white-space: nowrap;
    }

    .distribution-gia-row {
        border-top: 1px solid #e9ecef;
        padding: 12px 0;
    }

        .distribution-gia-row:first-child {
            border-top: none;
            padding-top: 0;
        }

    .distribution-gia-title {
        font-weight: 600;
    }

    .distribution-gia-subtitle,
    .distribution-gia-meta {
        font-size: 0.9rem;
        color: #6c757d;
    }

    .distribution-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .distribution-assigned-chip {
        cursor: default;
        padding-right: 8px;
    }

        .distribution-assigned-chip .btn {
            border-radius: 999px;
            padding: 1px 7px;
            line-height: 1.2;
            font-size: 0.78rem;
        }

    .distribution-empty-section {
        margin-bottom: 0;
    }

    @@media (max-width: 991.98px) {
        .distribution-toolbar {
            grid-template-columns: 1fr;
        }

        .distribution-worktype-row {
            grid-template-columns: 1fr;
        }

        .distribution-worktype-title {
            padding-top: 0;
        }

        .distribution-modal-header-wrap {
            flex-direction: column;
            padding-right: 24px;
        }

        .distribution-modal-header-stats {
            width: 100%;
            justify-content: flex-start;
        }

        .distribution-mini-stat {
            min-width: 105px;
        }
    }
</style>

<h1>Распределение нагрузки</h1>

<form asp-action="Index" method="get" class="distribution-toolbar">
    <div>
        <label class="form-label">Учебный год</label>
        <select name="startYear" class="form-select form-select-sm" onchange="this.form.submit()">
            @foreach (var year in availableYearStarts)
            {
                var text = $"{year}-{year + 1}";
                if (year == Model.SelectedYearStart)
                {
                    <option value="@year" selected>@text</option>
                }
                else
                {
                    <option value="@year">@text</option>
                }
            }
        </select>
    </div>

    <div>
        <label class="form-label">Поиск преподавателя</label>
        <input type="text"
               class="form-control form-control-sm js-lecturer-search"
               placeholder="Введите ФИО или должность" />
    </div>

    <div>
        <label class="form-label">Фильтр</label>
        <select class="form-select form-select-sm js-lecturer-filter">
            <option value="all">Все преподаватели</option>
            <option value="with-load">С назначенной нагрузкой</option>
            <option value="without-load">Без нагрузки</option>
            <option value="assistant">Ассистенты</option>
        </select>
    </div>

    <div>
        <label class="form-label">Сортировка</label>
        <select class="form-select form-select-sm js-lecturer-sort">
            <option value="name-asc">По ФИО</option>
            <option value="assigned-desc">Больше назначено</option>
            <option value="assigned-asc">Меньше назначено</option>
            <option value="remaining-desc">Больше остаток</option>
            <option value="remaining-asc">Меньше остаток</option>
        </select>
    </div>
</form>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <div class="card shadow-sm distribution-summary-card">
            <div class="card-body">
                <div class="text-muted small">Всего нагрузки</div>
                <div class="fs-3 fw-semibold">@Model.TotalHours.ToString("0") ч.</div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm distribution-summary-card">
            <div class="card-body">
                <div class="text-muted small">Назначено</div>
                <div class="fs-3 fw-semibold">
                    <span class="js-page-assigned-hours"
                          data-value="@Model.AssignedHours.ToString("0.####").Replace(",", ".")">
                        @Model.AssignedHours.ToString("0")
                    </span> ч.
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm distribution-summary-card">
            <div class="card-body">
                <div class="text-muted small">Осталось</div>
                <div class="fs-3 fw-semibold">
                    <span class="js-page-remaining-hours"
                          data-value="@Model.RemainingHours.ToString("0.####").Replace(",", ".")">
                        @Model.RemainingHours.ToString("0")
                    </span> ч.
                </div>
            </div>
        </div>
    </div>
</div>

@if (!Model.Lecturers.Any())
{
    <div class="alert alert-info">
        Нет преподавателей для распределения нагрузки.
    </div>
}
else
{
    <div class="accordion js-lecturers-container" id="lecturersAccordion">
        @for (var i = 0; i < Model.Lecturers.Count; i++)
        {
            var lecturer = Model.Lecturers[i];
            var lecturerCollapseId = $"lecturer_{lecturer.LecturerId}";
            var modalId = $"loadModal_{lecturer.LecturerId}";
            var viewModalId = $"viewLoadModal_{lecturer.LecturerId}";

            var autumnAssignments = lecturer.Assignments
            .Where(x => !IsGiaAssignment(x.SourceTypeDisplayName))
            .Where(x => IsAutumnAssignment(x.Subtitle))
            .OrderBy(x => x.Title)
            .ThenBy(x => x.ElementDisplayName)
            .ThenBy(x => x.UnitName)
            .ToList();

            var springAssignments = lecturer.Assignments
            .Where(x => !IsGiaAssignment(x.SourceTypeDisplayName))
            .Where(x => IsSpringAssignment(x.Subtitle))
            .OrderBy(x => x.Title)
            .ThenBy(x => x.ElementDisplayName)
            .ThenBy(x => x.UnitName)
            .ToList();

            var otherAssignments = lecturer.Assignments
            .Where(x => !IsGiaAssignment(x.SourceTypeDisplayName))
            .Where(x => !autumnAssignments.Any(a => a.AssignmentId == x.AssignmentId))
            .Where(x => !springAssignments.Any(a => a.AssignmentId == x.AssignmentId))
            .OrderBy(x => x.Title)
            .ThenBy(x => x.ElementDisplayName)
            .ThenBy(x => x.UnitName)
            .ToList();

            var giaAssignments = lecturer.Assignments
            .Where(x => IsGiaAssignment(x.SourceTypeDisplayName))
            .OrderBy(x => x.Title)
            .ThenBy(x => x.ElementDisplayName)
            .ThenBy(x => x.UnitName)
            .ToList();

            var autumnSubjectGroups = autumnAssignments
            .GroupBy(x => new { x.Title, x.Subtitle })
            .Select(x => new
            {
                x.Key.Title,
                x.Key.Subtitle,
                Items = x.ToList()
            })
            .OrderBy(x => x.Title)
            .ToList();

            var springSubjectGroups = springAssignments
            .Concat(otherAssignments)
            .GroupBy(x => new { x.Title, x.Subtitle })
            .Select(x => new
            {
                x.Key.Title,
                x.Key.Subtitle,
                Items = x.ToList()
            })
            .OrderBy(x => x.Title)
            .ToList();

            var giaSubjectGroups = giaAssignments
            .GroupBy(x => new { x.Title, x.Subtitle })
            .Select(x => new
            {
                x.Key.Title,
                x.Key.Subtitle,
                Items = x.ToList()
            })
            .OrderBy(x => x.Title)
            .ToList();

            var autumnSectionId = $"viewAutumn_{lecturer.LecturerId}";
            var springSectionId = $"viewSpring_{lecturer.LecturerId}";
            var giaSectionId = $"viewGia_{lecturer.LecturerId}";

            <div class="accordion-item mb-2 border rounded js-lecturer-card"
                 data-lecturer-id="@lecturer.LecturerId"
                 data-name="@((lecturer.LecturerDisplayName ?? string.Empty).ToLower())"
                 data-post="@((lecturer.LecturerStudyPostTitle ?? string.Empty).ToLower())"
                 data-assigned="@lecturer.AssignedHours.ToString("0.####").Replace(",", ".")"
                 data-remaining="@lecturer.RemainingHours.ToString("0.####").Replace(",", ".")"
                 data-overloaded="@(lecturer.IsOverloaded ? "true" : "false")"
                 data-assistant="@(lecturer.IsAssistant ? "true" : "false")">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#@lecturerCollapseId">
                        <div class="d-flex justify-content-between align-items-center w-100 pe-3 flex-wrap gap-2">
                            <div>
                                <div class="fw-semibold">@lecturer.LecturerDisplayName</div>
                                <div class="small text-muted">
                                    @lecturer.LecturerStudyPostTitle · ставка по договору
                                    <span class="js-rate-label" data-lecturer-id="@lecturer.LecturerId">
                                        @lecturer.Rate.ToString("0.##")
                                    </span>
                                    · норма
                                    <span class="js-effective-norm"
                                          data-lecturer-id="@lecturer.LecturerId"
                                          data-norm-hours="@lecturer.NormHours"
                                          data-assigned-hours="@lecturer.AssignedHours.ToString("0.####").Replace(",", ".")">
                                        @lecturer.LimitHours.ToString("0")
                                    </span>
                                </div>
                            </div>

                            <div class="distribution-badges">
                                <span class="badge bg-secondary">
                                    Назначено:
                                    <span class="js-lecturer-assigned-badge"
                                          data-lecturer-id="@lecturer.LecturerId"
                                          data-value="@lecturer.AssignedHours.ToString("0.####").Replace(",", ".")">
                                        @lecturer.AssignedHours.ToString("0")
                                    </span>
                                </span>

                                <span class="badge bg-dark">
                                    Лимит:
                                    <span class="js-limit-badge" data-lecturer-id="@lecturer.LecturerId">
                                        @lecturer.LimitHours.ToString("0")
                                    </span>
                                </span>

                                <span class="badge @(lecturer.RemainingHours < 0 ? "bg-danger" : "bg-success") js-remaining-badge-wrapper"
                                      data-lecturer-id="@lecturer.LecturerId">
                                    Остаток:
                                    <span class="js-remaining-badge"
                                          data-lecturer-id="@lecturer.LecturerId"
                                          data-value="@lecturer.RemainingHours.ToString("0.####").Replace(",", ".")">
                                        @lecturer.RemainingHours.ToString("0")
                                    </span>
                                </span>

                                @if (lecturer.IsAssistant)
                                {
                                    <span class="badge bg-warning text-dark">Ассистент</span>
                                }
                            </div>
                        </div>
                    </button>
                </h2>

                <div id="@lecturerCollapseId"
                     class="accordion-collapse collapse"
                     data-bs-parent="#lecturersAccordion">
                    <div class="accordion-body">
                        <form asp-action="SaveLecturerPlan" method="post" class="row g-2 align-items-end mb-3">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="SelectedYearStart" value="@Model.SelectedYearStart" />
                            <input type="hidden" name="SelectedLecturerId" value="@lecturer.LecturerId" />
                            <input type="hidden" name="LecturerId" value="@lecturer.LecturerId" />

                            <div class="col-md-4">
                                <label class="form-label">Должность</label>
                                <select name="LecturerStudyPostId" class="form-select form-select-sm">
                                    <option value="">Выберите должность</option>
                                    @foreach (var post in Model.StudyPosts)
                                    {
                                        if (post.Id == lecturer.LecturerStudyPostId)
                                        {
                                            <option value="@post.Id" selected>@post.Title — @post.NormHours ч.</option>
                                        }
                                        else
                                        {
                                            <option value="@post.Id">@post.Title — @post.NormHours ч.</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Ставка по договору</label>
                                <select name="Rate"
                                        class="form-select form-select-sm js-rate-select"
                                        data-lecturer-id="@lecturer.LecturerId"
                                        data-norm-hours="@lecturer.NormHours"
                                        data-assigned-hours="@lecturer.AssignedHours.ToString("0.####").Replace(",", ".")">
                                    @if (lecturer.Rate == 0.25m)
                                    {
                                        <option value="0.25" selected>0,25</option>
                                    }
                                    else
                                    {
                                        <option value="0.25">0,25</option>
                                    }

                                    @if (lecturer.Rate == 0.5m)
                                    {
                                        <option value="0.5" selected>0,5</option>
                                    }
                                    else
                                    {
                                        <option value="0.5">0,5</option>
                                    }

                                    @if (lecturer.Rate == 1m)
                                    {
                                        <option value="1" selected>1</option>
                                    }
                                    else
                                    {
                                        <option value="1">1</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-2">
                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                    Сохранить
                                </button>
                            </div>

                            <div class="col-md-3 text-md-end">
                                <button type="button"
                                        class="btn btn-sm btn-success"
                                        data-bs-toggle="modal"
                                        data-bs-target="#@modalId">
                                    Добавить нагрузку
                                </button>

                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary ms-1"
                                        data-bs-toggle="modal"
                                        data-bs-target="#@viewModalId">
                                    Просмотр нагрузки
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="modal fade distribution-modal js-load-modal"
                 id="@modalId"
                 tabindex="-1"
                 data-remaining-hours="@Math.Max(0, lecturer.RemainingHours).ToString("0").Replace(",", ".")">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content">
                        <form asp-action="AddSelectedAssignments" method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="SelectedYearStart" value="@Model.SelectedYearStart" />
                            <input type="hidden" name="SelectedLecturerId" value="@lecturer.LecturerId" />
                            <input type="hidden" name="LecturerId" value="@lecturer.LecturerId" />

                            <div class="modal-header">
                                <div class="distribution-modal-header-wrap">
                                    <div class="distribution-modal-header-left">
                                        <div class="distribution-modal-title">
                                            Добавить нагрузку: @lecturer.LecturerDisplayName
                                        </div>
                                        <div class="distribution-modal-subtitle">
                                            @lecturer.LecturerStudyPostTitle
                                        </div>
                                    </div>

                                    <div class="distribution-modal-header-stats">
                                        <div class="distribution-mini-stat">
                                            <div class="distribution-mini-stat-label">Свободно</div>
                                            <div class="distribution-mini-stat-value">
                                                <span class="js-free-hours">@Math.Max(0, lecturer.RemainingHours).ToString("0")</span> ч.
                                            </div>
                                        </div>

                                        <div class="distribution-mini-stat">
                                            <div class="distribution-mini-stat-label">Выбрано</div>
                                            <div class="distribution-mini-stat-value">
                                                <span class="js-selected-hours">0</span> ч.
                                            </div>
                                        </div>

                                        <div class="distribution-mini-stat">
                                            <div class="distribution-mini-stat-label">Останется</div>
                                            <div class="distribution-mini-stat-value">
                                                <span class="js-after-assign-hours">@Math.Max(0, lecturer.RemainingHours).ToString("0")</span> ч.
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>

                            <div class="modal-body">
                                @if (!lecturer.SemesterGroups.Any() && !lecturer.GiaItems.Any())
                                {
                                    <div class="alert alert-info">
                                        Нет свободных элементов нагрузки для назначения.
                                    </div>
                                }
                                else
                                {
                                    <div class="accordion" id="loadAccordion_@lecturer.LecturerId">

                                        @for (var semesterIndex = 0; semesterIndex < lecturer.SemesterGroups.Count; semesterIndex++)
                                        {
                                            var semester = lecturer.SemesterGroups[semesterIndex];
                                            var semesterId = $"semester_{lecturer.LecturerId}_{semesterIndex}";

                                            <div class="accordion-item mb-2">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button collapsed"
                                                            type="button"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#@semesterId">
                                                        @semester.SemesterName
                                                    </button>
                                                </h2>

                                                <div id="@semesterId"
                                                     class="accordion-collapse collapse">
                                                    <div class="accordion-body">

                                                        <div class="accordion" id="disciplineAccordion_@lecturer.LecturerId@semesterIndex">
                                                            @for (var disciplineIndex = 0; disciplineIndex < semester.Disciplines.Count; disciplineIndex++)
                                                            {
                                                                var discipline = semester.Disciplines[disciplineIndex];
                                                                var disciplineId = $"discipline_{lecturer.LecturerId}_{semesterIndex}_{disciplineIndex}";

                                                                <div class="accordion-item mb-2">
                                                                    <h2 class="accordion-header">
                                                                        <button class="accordion-button collapsed"
                                                                                type="button"
                                                                                data-bs-toggle="collapse"
                                                                                data-bs-target="#@disciplineId">
                                                                            <div>
                                                                                <div>@discipline.Title</div>
                                                                                <div class="small text-muted">@discipline.Subtitle</div>
                                                                            </div>
                                                                        </button>
                                                                    </h2>

                                                                    <div id="@disciplineId"
                                                                         class="accordion-collapse collapse">
                                                                        <div class="accordion-body">
                                                                            @foreach (var workType in discipline.WorkTypes)
                                                                            {
                                                                                <div class="distribution-worktype-row">
                                                                                    <div class="distribution-worktype-title">
                                                                                        @workType.ElementDisplayName:
                                                                                    </div>

                                                                                    <div class="distribution-chip-list">
                                                                                        @foreach (var item in workType.Items)
                                                                                        {
                                                                                            <label class="distribution-chip js-load-chip">
                                                                                                <input type="checkbox"
                                                                                                       name="SelectedItemKeys"
                                                                                                       value="@item.ItemKey"
                                                                                                       class="form-check-input js-load-item-checkbox"
                                                                                                       data-hours="@item.RemainingHours.ToString("0").Replace(",", ".")" />

                                                                                                <span class="distribution-chip-main">
                                                                                                    <span class="distribution-chip-title">
                                                                                                        @item.UnitName
                                                                                                    </span>
                                                                                                    <span class="distribution-chip-meta">
                                                                                                        @item.RemainingHours.ToString("0") ч.
                                                                                                        @if (item.StudentsCount > 0)
