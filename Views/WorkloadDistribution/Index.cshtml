                                                                                    <form asp-action="DeleteAssignment"
                                                                                          method="post"
                                                                                          class="m-0 js-delete-assignment-form"
                                                                                          data-lecturer-id="@lecturer.LecturerId"
                                                                                          data-hours="@assignment.AssignedHours.ToString("0.####").Replace(",", ".")">
                                                                                        @Html.AntiForgeryToken()

                                                                                        <input type="hidden" name="SelectedYearStart" value="@Model.SelectedYearStart" />
                                                                                        <input type="hidden" name="SelectedLecturerId" value="@lecturer.LecturerId" />
                                                                                        <input type="hidden" name="AssignmentId" value="@assignment.AssignmentId" />

                                                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                                                            ×
                                                                                        </button>
                                                                                    </form>
                                                                                </div>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item js-view-section">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed"
                                                type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@additionalSectionId">
                                            Доп. работа
                                            <span class="badge bg-secondary ms-2">
                                                <span class="js-view-section-hours">
                                                    @additionalAssignments.Sum(x => x.AssignedHours).ToString("0")
                                                </span> ч.
                                            </span>
                                        </button>
