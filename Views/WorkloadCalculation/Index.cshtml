@model DepartmentLoadApp.ViewModels.Workload.WorkloadTablePageViewModel

@{
    ViewData["Title"] = "Расчет нагрузки по дисциплинам";

    var pastelColors = new[]
    {
        "#fff4d6",
        "#e3f2fd",
        "#e8f5e9",
        "#fce4ec",
        "#ede7f6",
        "#e0f7fa",
        "#f3e5f5",
        "#fffde7",
        "#f1f8e9",
        "#e8eaf6"
    };

    var directions = (Model.Rows ?? new())
        .Select(x => x.DirectionCode)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();

    var directionColorMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

    for (var i = 0; i < directions.Count; i++)
    {
        directionColorMap[directions[i]] = pastelColors[i % pastelColors.Length];
    }
}

<style>
    .workload-table-wrapper {
        max-width: 100%;
        height: calc(100vh - 20px);
        min-height: 560px;
        overflow: auto;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        background: #fff;
    }
    .workload-calculation-table {
        width: 100%;
        min-width: 1280px;
        table-layout: fixed;
        font-size: 0.86rem;
        margin-bottom: 0;
    }

        .workload-calculation-table col.semester-column {
            width: 92px;
        }

        .workload-calculation-table col.direction-column {
            width: 64px;
        }

        .workload-calculation-table col.discipline-column {
            width: 290px;
        }

        .workload-calculation-table col.equal-column {
            width: 52px;
        }

        .workload-calculation-table th,
        .workload-calculation-table td {
            vertical-align: middle;
            text-align: center;
            padding: 0.22rem;
            border-color: #dee2e6;
        }

        .workload-calculation-table thead th {
            position: sticky;
            background: #f8f9fa !important;
            color: #212529 !important;
            border-color: #dee2e6 !important;
            vertical-align: middle;
            font-weight: 700;
            z-index: 5;
        }

        .workload-calculation-table thead tr:first-child th {
            top: 0;
            height: 34px;
            z-index: 7;
        }

        .workload-calculation-table thead tr:nth-child(2) th {
            top: 34px;
            height: 150px;
            z-index: 6;
        }

        .workload-calculation-table thead th[rowspan="2"] {
            top: 0;
            z-index: 8;
        }

        .workload-calculation-table .text-cell {
            text-align: left;
        }

        .workload-calculation-table .vertical-header {
            height: 150px;
            padding: 4px 2px;
        }

            .workload-calculation-table .vertical-header > span {
                writing-mode: vertical-rl;
                transform: rotate(180deg);
                display: inline-block;
                line-height: 1.05;
                white-space: nowrap;
            }

        .workload-calculation-table .control-cell {
            font-size: 0.82rem;
            line-height: 1.1;
        }

        .workload-calculation-table .total-column,
        .workload-calculation-table .total-cell {
            font-weight: 700;
        }

    @@media (max-width: 1199.98px) {
        .workload-calculation-table {
            font-size: 0.8rem;
        }

            .workload-calculation-table col.discipline-column {
                width: 250px;
            }

            .workload-calculation-table col.equal-column {
                width: 48px;
            }
    }
</style>

<h1>Расчет нагрузки по дисциплинам</h1>

@await Html.PartialAsync(
        "_CalculationTopPanel",
        new DepartmentLoadApp.ViewModels.Shared.CalculationTopPanelViewModel
    {
        SelectedYear = Model.SelectedYear,
        SelectedYearStart = Model.SelectedYearStart,
        AvailableYearStarts = Model.AvailableYearStarts,
        ActiveTab = "workload"
    })

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (Model.Rows == null || !Model.Rows.Any())
{
    <div class="alert alert-info">
        По выбранному учебному году данных пока нет.
    </div>
}
else
{
    <div class="direction-legend">
        @foreach (var direction in directions)
        {
            <div class="direction-legend-item">
                <span class="direction-legend-color"
                      style="background-color:@directionColorMap[direction]"></span>
                <span>@direction</span>
            </div>
        }
    </div>

    <div class="workload-table-wrapper">
        <table class="table table-bordered table-sm workload-calculation-table">
            <colgroup>
                <col class="semester-column" />
                <col class="direction-column" />
                <col class="discipline-column" />
                <col class="equal-column" />
                <col class="equal-column" />
                <col class="equal-column" />
                <col class="equal-column" />
                <col class="equal-column" />
                <col class="equal-column" />
                <col class="equal-column" />
                <col class="equal-column" />
                <col class="equal-column" />
                <col class="equal-column" />
                <col class="equal-column" />
                <col class="equal-column" />
                <col class="equal-column" />
                <col class="equal-column" />
                <col class="equal-column" />
                <col class="equal-column" />
                <col class="equal-column" />
                <col class="equal-column" />
            </colgroup>

            <thead>
                <tr>
                    <th class="vertical-header" rowspan="2">
                        <span>Семестр</span>
                    </th>
                    <th class="vertical-header" rowspan="2">
                        <span>Направление</span>
                    </th>
                    <th rowspan="2">Дисциплина</th>
                    <th class="vertical-header" rowspan="2">
                        <span>Курс</span>
                    </th>
                    <th class="vertical-header" rowspan="2">
                        <span>Студентов</span>
                    </th>
                    <th class="vertical-header" rowspan="2">
                        <span>Потоков</span>
                    </th>
                    <th class="vertical-header" rowspan="2">
                        <span>Групп</span>
                    </th>
                    <th class="vertical-header" rowspan="2">
                        <span>Подгрупп</span>
                    </th>
                    <th colspan="2">Лекции</th>
                    <th colspan="2">Практика</th>
                    <th colspan="2">Лабораторные</th>
                    <th colspan="5">Контроль</th>
                    <th class="vertical-header" rowspan="2">
                        <span>Консультации</span>
                    </th>
                    <th class="vertical-header total-column" rowspan="2">
                        <span>Итого</span>
                    </th>
                </tr>

                <tr>
                    <th class="vertical-header"><span>План</span></th>
                    <th class="vertical-header"><span>Всего</span></th>
                    <th class="vertical-header"><span>План</span></th>
                    <th class="vertical-header"><span>Всего</span></th>
                    <th class="vertical-header"><span>План</span></th>
                    <th class="vertical-header"><span>Всего</span></th>
                    <th class="vertical-header"><span>Экзамен</span></th>
                    <th class="vertical-header"><span>Зачет</span></th>
                    <th class="vertical-header"><span>Курсовая работа</span></th>
                    <th class="vertical-header"><span>Курсовой проект</span></th>
                    <th class="vertical-header"><span>РГР</span></th>
                </tr>
            </thead>

            <tbody class="js-calculation-table-body">
                @foreach (var row in Model.Rows)
                {
                    var directionColor = directionColorMap.TryGetValue(row.DirectionCode, out var color)
                    ? color
                    : "#ffffff";

                    <tr class="js-calculation-row calculation-row-colored"
                        style="--direction-color:@directionColor"
                        data-semester="@((row.SemesterName ?? string.Empty).ToLower())"
                        data-direction="@((row.DirectionCode ?? string.Empty).ToLower())"
                        data-name="@((row.DisciplineName ?? string.Empty).ToLower())"
                        data-course="@row.Course"
                        data-merged="@(row.IsMergedStream ? "true" : "false")"
                        data-exam="@(row.HasExam ? "true" : "false")"
                        data-credit="@(row.HasCredit ? "true" : "false")">

                        <td>@row.SemesterName</td>
                        <td>@row.DirectionCode</td>
                        <td class="text-cell">@row.DisciplineName</td>
                        <td>@row.Course</td>
                        <td>@row.StudentsCount</td>
                        <td>@row.FlowCount</td>
                        <td>@row.GroupCount</td>
                        <td>@row.SubgroupCount</td>

                        <td>@FormatHours(row.LecturePlanHours)</td>
                        <td>@FormatHours(row.LectureTotalHours)</td>

                        <td>@FormatHours(row.PracticePlanHours)</td>
                        <td>@FormatHours(row.PracticeTotalHours)</td>

                        <td>@FormatHours(row.LabPlanHours)</td>
                        <td>@FormatHours(row.LabTotalHours)</td>

                        <td class="control-cell">@FormatHours(row.ExamHours)</td>
                        <td class="control-cell">@FormatHours(row.CreditHours)</td>
                        <td class="control-cell">@FormatHours(row.CourseWorkHours)</td>
                        <td class="control-cell">@FormatHours(row.CourseProjectHours)</td>
                        <td class="control-cell">@FormatHours(row.RgrHours)</td>

                        <td>@FormatHours(row.ConsultationHours)</td>
                        <td class="total-cell">@FormatHours(row.TotalHours)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        function isAutumnSemester(value) {
            const text = String(value || "").toLowerCase();

            return text.includes("осен")
                || text.includes("осень")
                || text.includes("1 сем")
                || text.includes("1-й")
                || text === "1";
        }

        function isSpringSemester(value) {
            const text = String(value || "").toLowerCase();

            return text.includes("вес")
                || text.includes("весна")
                || text.includes("2 сем")
                || text.includes("2-й")
                || text === "2";
        }

        function parseCalculationNumber(value) {
            if (!value) {
                return 0;
            }

            return Number(String(value).replace(",", ".")) || 0;
        }

        function getSelectedDirections() {
            return Array.from(document.querySelectorAll(".js-direction-filter-checkbox:checked"))
                .map(function (checkbox) {
                    return checkbox.value;
                });
        }

        function updateDirectionFilterButton() {
            const button = document.querySelector(".js-direction-filter-button");
            const selectedDirections = getSelectedDirections();

            if (!button) {
                return;
            }

            if (selectedDirections.length === 0) {
                button.textContent = "Все направления";
                return;
            }

            if (selectedDirections.length === 1) {
                button.textContent = selectedDirections[0];
                return;
            }

            button.textContent = "Выбрано: " + selectedDirections.length;
        }

        function buildDirectionFilter() {
            const menu = document.querySelector(".js-direction-filter-menu");

            if (!menu) {
                return;
            }

            const directions = Array.from(document.querySelectorAll(".js-calculation-row"))
                .map(function (row) {
                    return row.dataset.direction || "";
                })
                .filter(function (direction) {
                    return direction.length > 0;
                })
                .filter(function (direction, index, array) {
                    return array.indexOf(direction) === index;
                })
                .sort();

            if (directions.length === 0) {
                menu.innerHTML = '<div class="text-muted small px-1">Направления не найдены.</div>';
                return;
            }

            menu.innerHTML = "";

            directions.forEach(function (direction) {
                const id = "directionFilter_" + direction.replace(/[^a-zA-Zа-яА-Я0-9]/g, "_");

                const label = document.createElement("label");
                label.className = "calculation-direction-option";

                label.innerHTML =
                    `<input type="checkbox"
                                    class="form-check-input js-direction-filter-checkbox"
                                    value="${direction}"
                                    id="${id}" />
                             <span>${direction}</span>`;

                menu.appendChild(label);
            });
        }

        function applyCalculationFiltersAndSort() {
            const tbody = document.querySelector(".js-calculation-table-body");

            if (!tbody) {
                return;
            }

            const search = (document.querySelector(".js-calculation-search")?.value || "").toLowerCase().trim();
            const filter = document.querySelector(".js-calculation-filter")?.value || "all";
            const sort = document.querySelector(".js-calculation-sort")?.value || "name-asc";
            const selectedDirections = getSelectedDirections();
            const rows = Array.from(tbody.querySelectorAll(".js-calculation-row"));

            rows.forEach(function (row) {
                const semester = row.dataset.semester || "";
                const direction = row.dataset.direction || "";
                const name = row.dataset.name || "";
                const merged = row.dataset.merged === "true";
                const hasExam = row.dataset.exam === "true";
                const hasCredit = row.dataset.credit === "true";

                let visible = true;

                if (search && !name.includes(search) && !direction.includes(search) && !semester.includes(search)) {
                    visible = false;
                }

                if (selectedDirections.length > 0 && !selectedDirections.includes(direction)) {
                    visible = false;
                }

                if (filter === "autumn" && !isAutumnSemester(semester)) {
                    visible = false;
                }

                if (filter === "spring" && !isSpringSemester(semester)) {
                    visible = false;
                }

                if (filter === "merged" && !merged) {
                    visible = false;
                }

                if (filter === "exam" && !hasExam) {
                    visible = false;
                }

                if (filter === "credit" && !hasCredit) {
                    visible = false;
                }

                row.classList.toggle("d-none", !visible);
            });

            rows.sort(function (a, b) {
                const nameA = a.dataset.name || "";
                const nameB = b.dataset.name || "";
                const directionA = a.dataset.direction || "";
                const directionB = b.dataset.direction || "";
                const courseA = parseCalculationNumber(a.dataset.course);
                const courseB = parseCalculationNumber(b.dataset.course);

                if (sort === "course-asc") {
                    return courseA - courseB || nameA.localeCompare(nameB);
                }

                if (sort === "direction-asc") {
                    return directionA.localeCompare(directionB) || nameA.localeCompare(nameB);
                }

                return nameA.localeCompare(nameB) || directionA.localeCompare(directionB);
            });

            rows.forEach(function (row) {
                tbody.appendChild(row);
            });

            updateDirectionFilterButton();
        }

        document.addEventListener("input", function (event) {
            if (event.target.classList.contains("js-calculation-search")) {
                applyCalculationFiltersAndSort();
            }
        });

        document.addEventListener("change", function (event) {
            if (event.target.classList.contains("js-calculation-filter")
                || event.target.classList.contains("js-calculation-sort")
                || event.target.classList.contains("js-direction-filter-checkbox")) {
                applyCalculationFiltersAndSort();
            }
        });

        buildDirectionFilter();
        applyCalculationFiltersAndSort();
    </script>
}

@functions {
    private static string FormatHours(decimal value)
    {
        return value <= 0
            ? string.Empty
            : value.ToString("0.##");
    }
}