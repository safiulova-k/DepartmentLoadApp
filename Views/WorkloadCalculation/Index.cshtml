@model DepartmentLoadApp.ViewModels.Workload.WorkloadTablePageViewModel

@{
    ViewData["Title"] = "Расчет нагрузки";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h1 class="h2 mb-2">Таблица расчета нагрузки</h1>
                    <div class="text-muted">
                        Расчет часов на основе контингента и норм времени
                    </div>
                </div>
            </div>

            <form asp-controller="WorkloadCalculation" asp-action="Save" method="post">
                <input type="hidden" asp-for="SelectedYear" />

                <div class="table-responsive">
                    <table class="table table-bordered align-middle workload-table">
                        <thead class="table-light">
                            <tr>
                                <th>Дисциплина</th>
                                <th>Семестр</th>
                                <th>Форма</th>
                                <th>Код направления</th>
                                <th>Курс</th>
                                <th>Студентов</th>
                                <th>Потоков</th>
                                <th>Групп</th>
                                <th>Подгрупп</th>
                                <th>Лекции (план)</th>
                                <th>Лекции (всего)</th>
                                <th>Практика (план)</th>
                                <th>Практика (всего)</th>
                                <th>Лаб (план)</th>
                                <th>Лаб (всего)</th>
                                <th>Итого</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Rows.Count; i++)
                            {
                                var row = Model.Rows[i];
                                var rowTotal = row.LectureTotalHours + row.PracticeTotalHours + row.LabTotalHours;

                                <tr>
                                    <td>
                                        <input type="hidden" asp-for="Rows[i].Id" />
                                        <input type="hidden" asp-for="Rows[i].PlanYear" />
                                        <input type="hidden" asp-for="Rows[i].AcademicPlanId" />
                                        <input type="hidden" asp-for="Rows[i].AcademicPlanRecordId" />
                                        <input type="hidden" asp-for="Rows[i].DisciplineId" />
                                        <input type="hidden" asp-for="Rows[i].DisciplineName" />
                                        <input type="hidden" asp-for="Rows[i].DirectionName" />
                                        <input type="hidden" asp-for="Rows[i].StudentsCount" />
                                        <input type="hidden" asp-for="Rows[i].GroupCount" />
                                        <input type="hidden" asp-for="Rows[i].SubgroupCount" />
                                        <input type="hidden" asp-for="Rows[i].LectureTotalHours" />
                                        <input type="hidden" asp-for="Rows[i].PracticeTotalHours" />
                                        <input type="hidden" asp-for="Rows[i].LabTotalHours" />

                                        <div class="fw-semibold">@row.DisciplineName</div>
                                    </td>

                                    <td>
                                        <input asp-for="Rows[i].SemesterName"
                                               class="form-control form-control-sm text-center"
                                               readonly />
                                    </td>

                                    <td>
                                        <input asp-for="Rows[i].EducationForm"
                                               class="form-control form-control-sm text-center"
                                               readonly />
                                    </td>

                                    <td>
                                        <input asp-for="Rows[i].DirectionCode"
                                               class="form-control form-control-sm text-center"
                                               readonly />
                                    </td>

                                    <td>
                                        <input asp-for="Rows[i].Course"
                                               class="form-control form-control-sm text-center"
                                               readonly />
                                    </td>

                                    <td class="text-center">
                                        @row.StudentsCount
                                    </td>

                                    <td>
                                        <input asp-for="Rows[i].FlowCount"
                                               class="form-control form-control-sm text-center"
                                               type="number"
                                               min="0" />
                                    </td>

                                    <td class="text-center">
                                        @row.GroupCount
                                    </td>

                                    <td class="text-center">
                                        @row.SubgroupCount
                                    </td>

                                    <td>
                                        <input asp-for="Rows[i].LecturePlanHours"
                                               class="form-control form-control-sm text-center"
                                               readonly />
                                    </td>

                                    <td class="text-center fw-semibold">
                                        @row.LectureTotalHours.ToString("0.##")
                                    </td>

                                    <td>
                                        <input asp-for="Rows[i].PracticePlanHours"
                                               class="form-control form-control-sm text-center"
                                               readonly />
                                    </td>

                                    <td class="text-center fw-semibold">
                                        @row.PracticeTotalHours.ToString("0.##")
                                    </td>

                                    <td>
                                        <input asp-for="Rows[i].LabPlanHours"
                                               class="form-control form-control-sm text-center"
                                               readonly />
                                    </td>

                                    <td class="text-center fw-semibold">
                                        @row.LabTotalHours.ToString("0.##")
                                    </td>

                                    <td class="text-center fw-bold">
                                        @rowTotal.ToString("0.##")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-primary px-4">
                        Сохранить и пересчитать
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>