@model DepartmentLoadApp.ViewModels.Workload.WorkloadTablePageViewModel

@{
    ViewData["Title"] = "Таблица расчета нагрузки";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-0 pb-0 d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <h2 class="mb-1">Таблица расчета нагрузки</h2>
                <p class="text-muted mb-3">Расчет часов на основе контингента и норм времени</p>
            </div>

            <form asp-controller="WorkloadCalculation" asp-action="AddRow" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary">
                    Добавить строку
                </button>
            </form>
        </div>

        <div class="card-body pt-0">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            <form asp-controller="WorkloadCalculation" asp-action="Save" method="post">
                @Html.AntiForgeryToken()

                <div class="table-responsive">
                    <table class="table table-bordered align-middle workload-table">
                        <thead>
                            <tr>
                                <th>Семестр</th>
                                <th>Форма</th>
                                <th>Код направления</th>
                                <th>Курс</th>
                                <th>Студентов</th>
                                <th>Потоков</th>
                                <th>Групп</th>
                                <th>Подгрупп</th>
                                <th>Лекции (план)</th>
                                <th>Лекции (всего)</th>
                                <th>Практика (план)</th>
                                <th>Практика (всего)</th>
                                <th>Лаб (план)</th>
                                <th>Лаб (всего)</th>
                                <th>Итого</th>
                            </tr>
                        </thead>

                        <tbody>
                            @for (int i = 0; i < Model.Rows.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <input type="hidden" name="Rows[@i].Id" value="@Model.Rows[i].Id" />

                                        <select name="Rows[@i].SemesterName" class="form-select form-select-sm">
                                            <option value="осень" selected="@(Model.Rows[i].SemesterName == "осень")">осень</option>
                                            <option value="весна" selected="@(Model.Rows[i].SemesterName == "весна")">весна</option>
                                        </select>
                                    </td>

                                    <td>
                                        <input type="text" class="form-control form-control-sm text-center"
                                               name="Rows[@i].EducationForm"
                                               value="@Model.Rows[i].EducationForm" />
                                    </td>

                                    <td>
                                        <input type="text" class="form-control form-control-sm text-center"
                                               name="Rows[@i].DirectionCode"
                                               value="@Model.Rows[i].DirectionCode" />
                                    </td>

                                    <td>
                                        <input type="number" class="form-control form-control-sm text-center"
                                               name="Rows[@i].Course"
                                               value="@Model.Rows[i].Course" min="1" max="4" />
                                    </td>

                                    <td class="text-center fw-semibold">
                                        @Model.Rows[i].StudentsCount
                                        <input type="hidden" name="Rows[@i].StudentsCount" value="@Model.Rows[i].StudentsCount" />
                                    </td>

                                    <td>
                                        <input type="number" class="form-control form-control-sm text-center"
                                               name="Rows[@i].FlowCount"
                                               value="@Model.Rows[i].FlowCount" min="0" />
                                    </td>

                                    <td>
                                        <input type="number" class="form-control form-control-sm text-center"
                                               name="Rows[@i].GroupCount"
                                               value="@Model.Rows[i].GroupCount" min="0" />
                                    </td>

                                    <td>
                                        <input type="number" class="form-control form-control-sm text-center"
                                               name="Rows[@i].SubgroupCount"
                                               value="@Model.Rows[i].SubgroupCount" min="0" />
                                    </td>

                                    <td>
                                        <input type="number" class="form-control form-control-sm text-center"
                                               name="Rows[@i].LecturePlanHours"
                                               value="@Model.Rows[i].LecturePlanHours" step="0.01" />
                                    </td>

                                    <td class="text-center fw-semibold">
                                        @Model.Rows[i].LectureTotalHours.ToString("0.##")
                                        <input type="hidden" name="Rows[@i].LectureTotalHours" value="@Model.Rows[i].LectureTotalHours" />
                                    </td>

                                    <td>
                                        <input type="number" class="form-control form-control-sm text-center"
                                               name="Rows[@i].PracticePlanHours"
                                               value="@Model.Rows[i].PracticePlanHours" step="0.01" />
                                    </td>

                                    <td class="text-center fw-semibold">
                                        @Model.Rows[i].PracticeTotalHours.ToString("0.##")
                                        <input type="hidden" name="Rows[@i].PracticeTotalHours" value="@Model.Rows[i].PracticeTotalHours" />
                                    </td>

                                    <td>
                                        <input type="number" class="form-control form-control-sm text-center"
                                               name="Rows[@i].LabPlanHours"
                                               value="@Model.Rows[i].LabPlanHours" step="0.01" />
                                    </td>

                                    <td class="text-center fw-semibold">
                                        @Model.Rows[i].LabTotalHours.ToString("0.##")
                                        <input type="hidden" name="Rows[@i].LabTotalHours" value="@Model.Rows[i].LabTotalHours" />
                                    </td>

                                    <td class="text-center fw-bold">
                                        @(Model.Rows[i].LectureTotalHours + Model.Rows[i].PracticeTotalHours + Model.Rows[i].LabTotalHours).ToString("0.##")
                                    </td>
                                </tr>
                            }

                            <tr class="summary-row total-row">
                                <td colspan="9" class="text-end fw-bold">Итого</td>
                                <td class="text-center fw-bold">@Model.TotalLectureHours.ToString("0.##")</td>
                                <td></td>
                                <td class="text-center fw-bold">@Model.TotalPracticeHours.ToString("0.##")</td>
                                <td></td>
                                <td class="text-center fw-bold">@Model.TotalLabHours.ToString("0.##")</td>
                                <td class="text-center fw-bold">@Model.GrandTotalHours.ToString("0.##")</td>
                            </tr>

                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-end mt-3">
                    <button type="submit" class="btn btn-primary px-4">
                        Сохранить и пересчитать
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>