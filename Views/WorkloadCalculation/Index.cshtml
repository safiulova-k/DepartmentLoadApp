        <input type="hidden" asp-for="Rows[i].ConsultationHours" />
        <input type="hidden" asp-for="Rows[i].ExamHours" />
        <input type="hidden" asp-for="Rows[i].CreditHours" />
        <input type="hidden" asp-for="Rows[i].CourseWorkHours" />
        <input type="hidden" asp-for="Rows[i].CourseProjectHours" />
        <input type="hidden" asp-for="Rows[i].ReferatRgrHours" />
        <input type="hidden" asp-for="Rows[i].DiplomaHours" />
        <input type="hidden" asp-for="Rows[i].GekHours" />
        <input type="hidden" asp-for="Rows[i].PracticeManagementHours" />
        <input type="hidden" asp-for="Rows[i].EducationalPracticeHours" />
        <input type="hidden" asp-for="Rows[i].IndustrialPracticeHours" />
        <input type="hidden" asp-for="Rows[i].PreDiplomaPracticeHours" />
        <input type="hidden" asp-for="Rows[i].ScientificPedagogicalPracticeHours" />
