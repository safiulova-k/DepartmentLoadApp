@model DepartmentLoadApp.ViewModels.Practice.PracticeWorkloadPageViewModel

@{
    ViewData["Title"] = "Практики";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <div class="mb-4">
                <h1 class="h2 mb-2">Практики</h1>
                <div class="text-muted">
                    Для практик вручную задается количество недель. Количество студентов подтягивается из контингента,
                    коэффициент берется со страницы норм времени, итог рассчитывается автоматически.
                </div>
            </div>

            <form asp-controller="PracticeCalculation" asp-action="Save" method="post">
                <input type="hidden" asp-for="SelectedYear" />

                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Код направления</th>
                                <th>Вид практики</th>
                                <th>Курс</th>
                                <th>Студентов</th>
                                <th>Количество недель</th>
                                <th>Итого</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Rows.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <input type="hidden" asp-for="Rows[i].Id" />
                                        <input type="hidden" asp-for="Rows[i].PlanYear" />
                                        <input type="hidden" asp-for="Rows[i].PracticeName" />
                                        <input type="hidden" asp-for="Rows[i].DirectionName" />
                                        <input type="hidden" asp-for="Rows[i].StudentsCount" />
                                        <input type="hidden" asp-for="Rows[i].TotalHours" />

                                        <input asp-for="Rows[i].DirectionCode"
                                               class="form-control form-control-sm text-center"
                                               readonly />
                                    </td>

                                    <td>
                                        <div class="fw-semibold">@Model.Rows[i].PracticeName</div>
                                    </td>

                                    <td>
                                        <input asp-for="Rows[i].Course"
                                               class="form-control form-control-sm text-center"
                                               readonly />
                                    </td>

                                    <td class="text-center fw-semibold">
                                        @Model.Rows[i].StudentsCount
                                    </td>

                                    <td>
                                        <input asp-for="Rows[i].WeeksCount"
                                               class="form-control form-control-sm text-center"
                                               type="text"
                                               inputmode="decimal" />
                                        <span asp-validation-for="Rows[i].WeeksCount" class="text-danger small"></span>
                                    </td>

                                    <td class="text-center fw-bold">
                                        @Model.Rows[i].TotalHours.ToString("0.##")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-primary px-4">
                        Сохранить и пересчитать
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}