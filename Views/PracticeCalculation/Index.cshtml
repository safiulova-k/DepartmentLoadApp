@model DepartmentLoadApp.ViewModels.Practice.PracticeWorkloadPageViewModel

@{
    ViewData["Title"] = "Практики";

    var pastelColors = new[]
    {
        "#fff4d6",
        "#e3f2fd",
        "#e8f5e9",
        "#fce4ec",
        "#ede7f6",
        "#e0f7fa",
        "#f3e5f5",
        "#fffde7",
        "#f1f8e9",
        "#e8eaf6"
    };

    var directions = (Model.Rows ?? new())
        .Select(x => x.DirectionCode)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();

    var directionColorMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

    for (var i = 0; i < directions.Count; i++)
    {
        directionColorMap[directions[i]] = pastelColors[i % pastelColors.Length];
    }
}

<h1 class="mb-4">Расчет нагрузки по практикам</h1>

@await Html.PartialAsync(
        "_CalculationTopPanel",
        new DepartmentLoadApp.ViewModels.Shared.CalculationTopPanelViewModel
    {
        SelectedYear = Model.SelectedYear,
        SelectedYearStart = Model.SelectedYearStart,
        AvailableYearStarts = Model.AvailableYearStarts,
        ActiveTab = "practice"
    })

@if (Model.Rows == null || !Model.Rows.Any())
{
    <div class="alert alert-info">
        По выбранному учебному году данных пока нет.
    </div>
}
else
{
    <div class="d-flex flex-wrap gap-2 mb-3">
        @foreach (var direction in directions)
        {
            <span class="badge rounded-pill text-dark border bg-white px-3 py-2">
                <span class="d-inline-block rounded-circle me-2"
                      style="width: 18px; height: 18px; background-color: @directionColorMap[direction]; vertical-align: middle;">
                </span>
                @direction
            </span>
        }
    </div>

    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Семестр</th>
                    <th>Код направления</th>
                    <th>Вид практики</th>
                    <th class="text-center">Курс</th>
                    <th class="text-center">Групп</th>
                    <th class="text-center">Студентов</th>
                    <th class="text-center">Недель</th>
                    <th class="text-center">Итого</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    var directionColor = directionColorMap.TryGetValue(row.DirectionCode, out var color)
                    ? color
                    : "#ffffff";

                    <tr style="background-color: @directionColor;">
                        <td>@row.SemesterName</td>
                        <td>@row.DirectionCode</td>
                        <td>@row.PracticeName</td>
                        <td class="text-center">@row.Course</td>
                        <td class="text-center">@row.GroupCount</td>
                        <td class="text-center">@row.StudentsCount</td>
                        <td class="text-center fw-semibold">@row.WeeksCount</td>
                        <td class="text-center fw-bold">@row.TotalHours.ToString("0.##")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
}