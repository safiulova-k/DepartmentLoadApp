@model List<DepartmentLoadApp.Models.Teacher>

@{
    ViewData["Title"] = "Преподаватели";
}

<h1>Преподаватели</h1>

<div class="mb-3 d-flex gap-2">
    <form asp-action="ImportFromMock" method="post">
        <button type="submit" class="btn btn-primary">Загрузить</button>
    </form>

    <a asp-action="Create" class="btn btn-success">Добавить вручную</a>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Внешний Id</th>
            <th>ФИО</th>
            <th>Должность</th>
            <th style="width: 180px;">Действия</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="4" class="text-center">Преподаватели не найдены</td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.ExternalLecturerId</td>
                    <td>@item.FullName</td>
                    <td>@item.Position</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Изменить</a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Удалить преподавателя?');">
                                Удалить
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>