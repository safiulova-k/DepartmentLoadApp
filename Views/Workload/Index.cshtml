@model DepartmentLoadApp.Models.Workload.WorkloadTablePageViewModel
@using DepartmentLoadApp.Models.Enums

@{
    ViewData["Title"] = "Таблица расчета нагрузки";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Дисциплины (модули)</h2>
        <div class="d-flex gap-2">
            <button type="submit" form="workloadForm" class="btn btn-outline-secondary">
                Сохранить
            </button>
            <button type="submit"
                    form="workloadForm"
                    formaction="@Url.Action("Calculate", "Workload")"
                    formmethod="post"
                    class="btn btn-primary">
                Выполнить расчет
            </button>
            <button type="submit"
                    form="workloadForm"
                    formaction="@Url.Action("AddDisciplineRow", "Workload")"
                    formmethod="post"
                    class="btn btn-outline-primary">
                Добавить строку
            </button>
        </div>
    </div>

    <form id="workloadForm" asp-action="Index" asp-controller="Workload" method="post">
        <datalist id="directionCodesList">
            <option value="09.03.03"></option>
            <option value="09.03.04"></option>
            <option value="09.04.04"></option>
            <option value="09.04.03"></option>
            <option value="09.04.03 БИ"></option>
        </datalist>

        <div class="table-responsive">
            <table class="table table-bordered align-middle workload-table">
                <thead>
                    <tr>
                        <th rowspan="2">Семестр</th>
                        <th rowspan="2">Форма обучения</th>
                        <th rowspan="2">Дисциплина по выбору</th>
                        <th rowspan="2">Код направления(специальности) по ФГОС 3+</th>
                        <th rowspan="2" style="min-width: 280px;">Полное наименование дисциплин</th>
                        <th rowspan="2">Курс</th>
                        <th rowspan="2">Студентов</th>
                        <th rowspan="2">Потоков</th>
                        <th rowspan="2">Групп</th>
                        <th rowspan="2">Подгрупп</th>

                        <th colspan="2">Лекции</th>
                        <th colspan="2">Практ.Семин.</th>
                        <th colspan="2">Лаборат.занятия</th>
                        <th colspan="4">По учебному плану</th>

                        <th rowspan="2">Консультации</th>
                        <th rowspan="2">Экзамен</th>
                        <th rowspan="2">Зачет</th>
                        <th rowspan="2">Курсовая работа</th>
                        <th rowspan="2">Курсовой проект</th>
                        <th rowspan="2">Орг.работа</th>
                        <th rowspan="2">Руков. научной работой</th>
                        <th rowspan="2">Рефераты/РГР</th>
                        <th rowspan="2">Итого</th>
                    </tr>
                    <tr>
                        <th>По плану часов</th>
                        <th>Всего часов</th>
                        <th>По плану часов</th>
                        <th>Всего часов</th>
                        <th>По плану часов</th>
                        <th>Всего часов</th>

                        <th>Экзамен</th>
                        <th>Зачет</th>
                        <th>Курсовая работа</th>
                        <th>Курсовой проект</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.DisciplineRows.Count; i++)
                    {
                        <tr class="discipline-row">
                            <td>
                                <input type="hidden" asp-for="DisciplineRows[i].Id" />
                                <input type="hidden" asp-for="DisciplineRows[i].DisplayOrder" />
                                <input type="hidden" asp-for="DisciplineRows[i].IsSectionHeader" />
                                <input type="hidden" asp-for="DisciplineRows[i].SectionType" />
                                <input type="hidden" asp-for="DisciplineRows[i].RowKind" />
                                <input type="hidden" asp-for="DisciplineRows[i].FormulaType" />

                                <select asp-for="DisciplineRows[i].Semester" class="form-select form-select-sm">
                                    <option value="">Выбрать</option>
                                    <option value="@SemesterType.Autumn">Осень</option>
                                    <option value="@SemesterType.Spring">Весна</option>
                                </select>
                            </td>

                            <td>
                                <input asp-for="DisciplineRows[i].EducationForm"
                                       class="form-control form-control-sm" />
                            </td>

                            <td class="text-center">
                                <input asp-for="DisciplineRows[i].IsElectiveDiscipline"
                                       class="form-check-input" />
                            </td>

                            <td>
                                <input asp-for="DisciplineRows[i].DirectionCode"
                                       class="form-control form-control-sm"
                                       list="directionCodesList" />
                            </td>

                            <td>
                                <input asp-for="DisciplineRows[i].DisciplineName"
                                       class="form-control form-control-sm" />
                            </td>

                            <td>
                                <input asp-for="DisciplineRows[i].Course"
                                       class="form-control form-control-sm"
                                       type="number"
                                       min="0" />
                            </td>

                            <td>
                                <input asp-for="DisciplineRows[i].StudentsCount"
                                       class="form-control form-control-sm students-count"
                                       type="number"
                                       min="0" />
                            </td>

                            <td>
                                <input asp-for="DisciplineRows[i].StreamsCount"
                                       class="form-control form-control-sm"
                                       type="number"
                                       min="0" />
                            </td>

                            <td>
                                <input asp-for="DisciplineRows[i].GroupsCount"
                                       class="form-control form-control-sm groups-count"
                                       type="number"
                                       min="0" />
                            </td>

                            <td>
                                <input asp-for="DisciplineRows[i].SubGroupsCount"
                                       class="form-control form-control-sm subgroups-count"
                                       type="number"
                                       min="0" />
                            </td>

                            <td>
                                <input asp-for="DisciplineRows[i].LecturePlanHours"
                                       class="form-control form-control-sm lecture-plan"
                                       type="number"
                                       step="0.01"
                                       min="0" />
                            </td>

                            <td>
                                <input asp-for="DisciplineRows[i].LectureTotalHours"
                                       class="form-control form-control-sm bg-light lecture-total"
                                       readonly />
                            </td>

                            <td>
                                <input asp-for="DisciplineRows[i].PracticePlanHours"
                                       class="form-control form-control-sm practice-plan"
                                       type="number"
                                       step="0.01"
                                       min="0" />
                            </td>

                            <td>
                                <input asp-for="DisciplineRows[i].PracticeTotalHours"
                                       class="form-control form-control-sm bg-light practice-total"
                                       readonly />
                            </td>

                            <td>
                                <input asp-for="DisciplineRows[i].LaboratoryPlanHours"
                                       class="form-control form-control-sm laboratory-plan"
                                       type="number"
                                       step="0.01"
                                       min="0" />
                            </td>

                            <td>
                                <input asp-for="DisciplineRows[i].LaboratoryTotalHours"
                                       class="form-control form-control-sm bg-light laboratory-total"
                                       readonly />
                            </td>

                            <td class="text-center">
                                <input asp-for="DisciplineRows[i].HasExamInPlan"
                                       class="form-check-input exam-plan" />
                            </td>

                            <td class="text-center">
                                <input asp-for="DisciplineRows[i].HasCreditInPlan"
                                       class="form-check-input credit-plan" />
                            </td>

                            <td class="text-center">
                                <input asp-for="DisciplineRows[i].HasCourseWorkInPlan"
                                       class="form-check-input coursework-plan" />
                            </td>

                            <td class="text-center">
                                <input asp-for="DisciplineRows[i].HasCourseProjectInPlan"
                                       class="form-check-input courseproject-plan" />
                            </td>

                            <td>
                                <input asp-for="DisciplineRows[i].ConsultationHours"
                                       class="form-control form-control-sm bg-light consultation-hours"
                                       readonly />
                            </td>

                            <td>
                                <input asp-for="DisciplineRows[i].ExamHours"
                                       class="form-control form-control-sm bg-light exam-hours"
                                       readonly />
                            </td>

                            <td>
                                <input asp-for="DisciplineRows[i].CreditHours"
                                       class="form-control form-control-sm bg-light credit-hours"
                                       readonly />
                            </td>

                            <td>
                                <input asp-for="DisciplineRows[i].CourseWorkHours"
                                       class="form-control form-control-sm bg-light coursework-hours"
                                       readonly />
                            </td>

                            <td>
                                <input asp-for="DisciplineRows[i].CourseProjectHours"
                                       class="form-control form-control-sm bg-light courseproject-hours"
                                       readonly />
                            </td>

                            <td>
                                <input asp-for="DisciplineRows[i].OrganizationalWorkHours"
                                       class="form-control form-control-sm org-work"
                                       type="number"
                                       step="0.01"
                                       min="0" />
                            </td>

                            <td>
                                <input asp-for="DisciplineRows[i].ResearchGuidanceHours"
                                       class="form-control form-control-sm research-guidance"
                                       type="number"
                                       step="0.01"
                                       min="0" />
                            </td>

                            <td>
                                <input asp-for="DisciplineRows[i].AbstractOrRgrHours"
                                       class="form-control form-control-sm abstract-rgr"
                                       type="number"
                                       step="0.01"
                                       min="0" />
                            </td>

                            <td>
                                <input asp-for="DisciplineRows[i].TotalHours"
                                       class="form-control form-control-sm bg-light fw-bold total-hours"
                                       readonly />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
</div>

<style>
    .workload-table {
        font-size: 13px;
        white-space: nowrap;
    }

        .workload-table thead th {
            text-align: center;
            vertical-align: middle;
            background: #f8f9fa;
        }

        .workload-table tbody td {
            vertical-align: middle;
        }

        .workload-table .form-check-input {
            margin-top: 0;
        }
</style>

<script>
    function toNumber(value) {
        const parsed = parseFloat((value || "0").toString().replace(",", "."));
        return isNaN(parsed) ? 0 : parsed;
    }

    function roundToHalf(value) {
        return Math.round(value * 2) / 2;
    }

    function roundToTwo(value) {
        return Math.round(value * 100) / 100;
    }

    function recalculateRow(row) {
        const students = toNumber(row.querySelector(".students-count")?.value);
        const groups = toNumber(row.querySelector(".groups-count")?.value);
        const subGroups = toNumber(row.querySelector(".subgroups-count")?.value);

        const lecturePlan = toNumber(row.querySelector(".lecture-plan")?.value);
        const practicePlan = toNumber(row.querySelector(".practice-plan")?.value);
        const laboratoryPlan = toNumber(row.querySelector(".laboratory-plan")?.value);

        const orgWork = toNumber(row.querySelector(".org-work")?.value);
        const researchGuidance = toNumber(row.querySelector(".research-guidance")?.value);
        const abstractRgr = toNumber(row.querySelector(".abstract-rgr")?.value);

        const hasExam = row.querySelector(".exam-plan")?.checked ?? false;
        const hasCredit = row.querySelector(".credit-plan")?.checked ?? false;
        const hasCourseWork = row.querySelector(".coursework-plan")?.checked ?? false;
        const hasCourseProject = row.querySelector(".courseproject-plan")?.checked ?? false;

        const lectureTotal = lecturePlan;
        const practiceTotal = practicePlan * groups;
        const laboratoryTotal = laboratoryPlan * subGroups;

        const consultation =
            roundToHalf(0.05 * groups * lecturePlan) +
            (hasExam ? 2 * groups : 0);

        const examHours = hasExam ? students * 0.3 : 0;
        const creditHours = hasCredit ? students * 0.2 : 0;
        const courseWorkHours = hasCourseWork ? students * 1.5 : 0;
        const courseProjectHours = hasCourseProject ? students * 3 : 0;

        const total =
            lectureTotal +
            practiceTotal +
            laboratoryTotal +
            consultation +
            examHours +
            creditHours +
            courseWorkHours +
            courseProjectHours +
            orgWork +
            researchGuidance +
            abstractRgr;

        const setValue = (selector, value) => {
            const element = row.querySelector(selector);
            if (element) {
                element.value = roundToTwo(value);
            }
        };

        setValue(".lecture-total", lectureTotal);
        setValue(".practice-total", practiceTotal);
        setValue(".laboratory-total", laboratoryTotal);
        setValue(".consultation-hours", consultation);
        setValue(".exam-hours", examHours);
        setValue(".credit-hours", creditHours);
        setValue(".coursework-hours", courseWorkHours);
        setValue(".courseproject-hours", courseProjectHours);
        setValue(".total-hours", total);
    }

    function bindRow(row) {
        const inputs = row.querySelectorAll("input, select");
        inputs.forEach(input => {
            input.addEventListener("input", () => recalculateRow(row));
            input.addEventListener("change", () => recalculateRow(row));
        });

        recalculateRow(row);
    }

    document.addEventListener("DOMContentLoaded", function () {
        const rows = document.querySelectorAll(".discipline-row");
        rows.forEach(bindRow);
    });
</script>