                            <td><input asp-for="GuidanceRows[i].StudentsCount" class="form-control form-control-sm" type="number" min="0" /></td>
                            <td><input asp-for="GuidanceRows[i].StreamsCount" class="form-control form-control-sm" type="number" min="0" /></td>
                            <td><input asp-for="GuidanceRows[i].GroupsCount" class="form-control form-control-sm" type="number" min="0" /></td>
                            <td><input asp-for="GuidanceRows[i].SubGroupsCount" class="form-control form-control-sm" type="number" min="0" /></td>
                            <td><input asp-for="GuidanceRows[i].LecturePlanHours" class="form-control form-control-sm" type="number" step="0.01" min="0" /></td>
                            <td><input asp-for="GuidanceRows[i].LectureTotalHours" class="form-control form-control-sm bg-light" type="number" step="0.01" readonly /></td>
                            <td><input asp-for="GuidanceRows[i].PracticePlanHours" class="form-control form-control-sm" type="number" step="0.01" min="0" /></td>
                            <td><input asp-for="GuidanceRows[i].PracticeTotalHours" class="form-control form-control-sm bg-light" type="number" step="0.01" readonly /></td>
                            <td><input asp-for="GuidanceRows[i].LaboratoryPlanHours" class="form-control form-control-sm" type="number" step="0.01" min="0" /></td>
                            <td><input asp-for="GuidanceRows[i].LaboratoryTotalHours" class="form-control form-control-sm bg-light" type="number" step="0.01" readonly /></td>
                            <td class="text-center"><input asp-for="GuidanceRows[i].HasExamInPlan" class="form-check-input" /></td>
                            <td class="text-center"><input asp-for="GuidanceRows[i].HasCreditInPlan" class="form-check-input" /></td>
