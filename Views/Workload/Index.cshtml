                            <td class="text-center"><input asp-for="GuidanceRows[i].IsElectiveDiscipline" class="form-check-input" /></td>
                            <td><input asp-for="GuidanceRows[i].DirectionCode" class="form-control form-control-sm" list="directionCodesList" /></td>
                            <td><input asp-for="GuidanceRows[i].DisciplineName" class="form-control form-control-sm" /></td>
