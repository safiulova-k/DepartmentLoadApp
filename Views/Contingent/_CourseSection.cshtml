@model DepartmentLoadApp.ViewModels.Contingent.ContingentCourseViewModel

@{
    var errorMessage = ViewData["ErrorMessage"]?.ToString();
    var errorStudentGroupId = ViewData["ErrorStudentGroupId"] as int?;

    var groupsCount = Model.Groups.Count;
    var subgroupsCount = Model.Groups.Sum(x => x.SubgroupsCount);
}

<div class="contingent-course-section mb-4 js-course-section"
     data-course-number="@Model.CourseNumber">
    <div class="contingent-course-header mb-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="fw-semibold fs-5">
                @Model.CourseNumber курс
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <span class="badge text-bg-primary">Групп: @groupsCount</span>
                <span class="badge text-bg-warning">Подгрупп: @subgroupsCount</span>
            </div>
        </div>
    </div>

    <div class="row g-2">
        @foreach (var group in Model.Groups)
        {
            var hasInlineError =
            errorStudentGroupId == group.StudentGroupId &&
            !string.IsNullOrWhiteSpace(errorMessage);

            <div class="col-12 col-md-6 col-xl-3">
                <form action="@Url.Action("SaveGroupSubgroups", "Contingent")"
                      method="post"
                      class="card border-0 shadow-sm h-100 contingent-group-card js-contingent-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="studentGroupId" value="@group.StudentGroupId" />

                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                            <div>
                                <div class="fw-semibold fs-5">@group.GroupName</div>
                                <div class="text-muted small">
                                    Студентов: @group.StudentsCount
                                </div>
                            </div>

                            <div class="d-flex gap-2 align-items-center flex-wrap">
                                <span class="badge text-bg-light">
                                    Подгрупп: @group.SubgroupsCount
                                </span>

                                @{
                                    var addUrl = Url.Action(
                                    "AddSubgroup",
                                    "Contingent",
                                    new { studentGroupId = group.StudentGroupId });
                                }

                                <button type="submit"
                                        class="btn btn-outline-primary btn-sm"
                                        formaction="@addUrl"
                                        formmethod="post">
                                    Добавить п/г
                                </button>
                            </div>
                        </div>

                        @for (int subgroupIndex = 0; subgroupIndex < group.Subgroups.Count; subgroupIndex++)
                        {
                            var subgroup = group.Subgroups[subgroupIndex];

                            <div class="row g-2 align-items-center mb-2">
                                <div class="col-12 col-md-3">
                                    <label class="form-label mb-0 fw-semibold">@subgroup.Name</label>
                                </div>

                                <div class="col-12 col-md-5">
                                    <input type="hidden" name="subgroupIds" value="@subgroup.Id" />
                                    <input type="number"
                                           name="studentsCounts"
                                           class="form-control form-control-sm"
                                           min="0"
                                           value="@subgroup.StudentsCount" />
                                </div>

                                <div class="col-12 col-md-auto">
                                    @if (group.Subgroups.Count > 1)
                                    {
                                        var deleteUrl = Url.Action(
                                        "DeleteSubgroup",
                                        "Contingent",
                                        new
                                        {
                                            studentGroupId = group.StudentGroupId,
                                            subgroupId = subgroup.Id
                                        });

                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm"
                                                formaction="@deleteUrl"
                                                formmethod="post">
                                            Удалить
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                        <div class="small mt-2 @(hasInlineError ? "text-danger fw-semibold" : "text-muted")">
                            Сумма студентов по подгруппам должна быть равна @group.StudentsCount.
                        </div>
                    </div>

                    <div class="card-footer bg-white border-0 pt-0 pb-3 px-3">
                        <div class="d-flex justify-content-end">
                            <button type="submit"
                                    class="btn btn-success btn-sm"
                                    formaction="@Url.Action("SaveGroupSubgroups", "Contingent")"
                                    formmethod="post">
                                Сохранить
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        }
    </div>
</div>