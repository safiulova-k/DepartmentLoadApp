@model DepartmentLoadApp.ViewModels.Contingent.ContingentPageViewModel

@{
    ViewData["Title"] = "Контингент";
}

<div class="contingent-page">
    <h1 class="mb-3">Контингент</h1>

    <div id="contingent-content">
        @await Html.PartialAsync("_ContingentContent", Model)
    </div>
</div>

@section Scripts
{
    <script>
        (() => {
            const containerId = "contingent-content";
            const storageKey = "contingent-open-collapses";

            function getContainer() {
                return document.getElementById(containerId);
            }

            function getOpenCollapseIds(root = document) {
                return [...root.querySelectorAll(".accordion-collapse.show[id]")]
                    .map(x => x.id);
            }

            function saveOpenState(root = document) {
                const ids = getOpenCollapseIds(root);
                sessionStorage.setItem(storageKey, JSON.stringify(ids));
            }

            function restoreCollapses(ids) {
                ids.forEach(id => {
                    const el = document.getElementById(id);
                    if (!el) return;

                    if (window.bootstrap) {
                        bootstrap.Collapse.getOrCreateInstance(el, { toggle: false }).show();
                    } else {
                        el.classList.add("show");
                    }
                });
            }

            function restoreOpenState() {
                try {
                    const raw = sessionStorage.getItem(storageKey);
                    if (!raw) return;

                    const ids = JSON.parse(raw);
                    if (Array.isArray(ids)) {
                        restoreCollapses(ids);
                    }
                } catch {
                }
            }

            function openAccordion(targetId, scroll = true) {
                const collapse = document.getElementById(targetId);
                if (!collapse) return;

                if (window.bootstrap) {
                    bootstrap.Collapse.getOrCreateInstance(collapse, { toggle: false }).show();
                } else {
                    collapse.classList.add("show");
                }

                history.replaceState(null, "", "#" + targetId);
                saveOpenState(document);

                if (scroll) {
                    const card = collapse.closest(".accordion-item") || collapse;
                    card.scrollIntoView({ behavior: "smooth", block: "start" });
                }
            }

            async function submitContingentForm(form, submitter) {
                const container = getContainer();
                if (!container) return;

                const openIds = getOpenCollapseIds(document);
                const parentCollapse = form.closest(".accordion-collapse[id]");
                if (parentCollapse && !openIds.includes(parentCollapse.id)) {
                    openIds.push(parentCollapse.id);
                }

                const submitterAction = submitter?.getAttribute("formaction");
                const submitterMethod = submitter?.getAttribute("formmethod");

                const action = submitterAction ? submitterAction : form.action;
                const method = (submitterMethod || form.method || "post").toUpperCase();
                const formData = new FormData(form);

                const currentScrollY = window.scrollY;
                container.classList.add("contingent-loading");

                const response = await fetch(action, {
                    method,
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    body: formData
                });

                const html = await response.text();

                const wrapper = document.createElement("div");
                wrapper.innerHTML = html;

                const newCourseSection = wrapper.querySelector(".js-course-section");
                const currentCourseSection = form.closest(".js-course-section");

                if (newCourseSection && currentCourseSection) {
                    currentCourseSection.replaceWith(newCourseSection);
                } else {
                    container.innerHTML = html;
                }

                restoreCollapses(openIds);
                saveOpenState(document);

                if (parentCollapse) {
                    openAccordion(parentCollapse.id, false);
                }

                window.scrollTo({ top: currentScrollY, behavior: "auto" });

                requestAnimationFrame(() => {
                    container.classList.remove("contingent-loading");
                });
            }

            document.addEventListener("submit", async (e) => {
                const form = e.target.closest(".js-contingent-form");
                if (!form) return;

                e.preventDefault();
                await submitContingentForm(form, e.submitter);
            });

            document.addEventListener("click", (e) => {
                const openBtn = e.target.closest(".js-open-accordion");
                if (!openBtn) return;

                e.preventDefault();
                const targetId = openBtn.dataset.target;
                if (targetId) {
                    openAccordion(targetId, true);
                }
            });

            document.addEventListener("shown.bs.collapse", (e) => {
                if (e.target.matches(".accordion-collapse[id]")) {
                    saveOpenState(document);
                }
            });

            document.addEventListener("hidden.bs.collapse", (e) => {
                if (e.target.matches(".accordion-collapse[id]")) {
                    saveOpenState(document);
                }
            });

            document.addEventListener("DOMContentLoaded", () => {
                restoreOpenState();
            });
        })();
    </script>
}