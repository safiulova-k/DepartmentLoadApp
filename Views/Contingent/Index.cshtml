@model DepartmentLoadApp.ViewModels.Contingent.ContingentPageViewModel

@{
    ViewData["Title"] = "Контингент";
}

<div class="contingent-page">
    <h1 class="mb-3">Контингент</h1>

    <p class="text-muted mb-4">
        В ячейке сверху — студенты, ниже — группы, затем подгруппы.
        Данные по студентам и группам подставляются автоматически из синхронизированных учебных групп.
    </p>

    <div id="contingent-content">
        @await Html.PartialAsync("_ContingentContent", Model)
    </div>
</div>

@section Scripts
{
    <script>
        (() => {
            const containerId = "contingent-content";
            const storageKey = "contingent-open-collapses";

            function getContainer() {
                return document.getElementById(containerId);
            }

            function getOpenCollapseIds(root = document) {
                return [...root.querySelectorAll(".accordion-collapse.show[id]")]
                    .map(x => x.id);
            }

            function restoreCollapses(ids) {
                ids.forEach(id => {
                    const el = document.getElementById(id);
                    if (!el) return;

                    if (window.bootstrap) {
                        bootstrap.Collapse.getOrCreateInstance(el, { toggle: false }).show();
                    } else {
                        el.classList.add("show");
                    }
                });
            }

            function saveOpenState(root = document) {
                const ids = getOpenCollapseIds(root);
                sessionStorage.setItem(storageKey, JSON.stringify(ids));
            }

            function restoreOpenState() {
                try {
                    const raw = sessionStorage.getItem(storageKey);
                    if (!raw) return;

                    const ids = JSON.parse(raw);
                    if (Array.isArray(ids)) {
                        restoreCollapses(ids);
                    }
                } catch {
                    // ignore
                }
            }

            function openAccordion(targetId, scroll = true) {
                const collapse = document.getElementById(targetId);
                if (!collapse) return;

                if (window.bootstrap) {
                    bootstrap.Collapse.getOrCreateInstance(collapse, { toggle: false }).show();
                } else {
                    collapse.classList.add("show");
                }

                history.replaceState(null, "", "#" + targetId);
                saveOpenState(document);

                if (scroll) {
                    const card = collapse.closest(".accordion-item") || collapse;
                    card.scrollIntoView({ behavior: "smooth", block: "start" });
                }
            }

            function openByHash(scroll = false) {
                if (!location.hash) return;
                const id = location.hash.replace("#", "");
                openAccordion(id, scroll);
            }

            async function submitContingentForm(form, submitter) {
                const container = getContainer();
                if (!container) return;

                const openIds = getOpenCollapseIds(document);
                const parentCollapse = form.closest(".accordion-collapse[id]");
                if (parentCollapse && !openIds.includes(parentCollapse.id)) {
                    openIds.push(parentCollapse.id);
                }

                const action = submitter?.formAction || form.action;
                const method = (submitter?.formMethod || form.method || "post").toUpperCase();
                const formData = new FormData(form);

                const response = await fetch(action, {
                    method,
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    body: formData
                });

                const html = await response.text();
                container.innerHTML = html;

                wireContingent();
                restoreCollapses(openIds);
                saveOpenState(document);

                if (parentCollapse) {
                    openAccordion(parentCollapse.id, true);
                }
            }

            function bindAjaxForms(root = document) {
                root.querySelectorAll(".js-contingent-form").forEach(form => {
                    form.addEventListener("submit", async e => {
                        e.preventDefault();
                        await submitContingentForm(form, e.submitter);
                    });
                });
            }

            function bindOpenButtons(root = document) {
                root.querySelectorAll(".js-open-accordion").forEach(btn => {
                    btn.addEventListener("click", e => {
                        e.preventDefault();
                        const targetId = btn.dataset.target;
                        if (!targetId) return;
                        openAccordion(targetId, true);
                    });
                });
            }

            function bindCollapseState(root = document) {
                root.querySelectorAll(".accordion-collapse[id]").forEach(collapse => {
                    collapse.addEventListener("shown.bs.collapse", () => saveOpenState(document));
                    collapse.addEventListener("hidden.bs.collapse", () => saveOpenState(document));
                });
            }

            window.wireContingent = function () {
                const root = getContainer() || document;
                bindAjaxForms(root);
                bindOpenButtons(root);
                bindCollapseState(root);
            };

            document.addEventListener("DOMContentLoaded", () => {
                wireContingent();
                restoreOpenState();
                openByHash(false);
            });

            window.addEventListener("hashchange", () => openByHash(true));
        })();
    </script>
}