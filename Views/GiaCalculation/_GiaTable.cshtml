@model List<DepartmentLoadApp.Models.Gia.GiaWorkloadRow>
@using System.Globalization

@{
    var directionColorMap = ViewData["DirectionColorMap"] as Dictionary<string, string>
        ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

    static string FormatDecimal(decimal value)
    {
        return value.ToString("0.##", CultureInfo.GetCultureInfo("ru-RU"));
    }

    static bool IsStateExamConsultation(string? workName)
    {
        if (string.IsNullOrWhiteSpace(workName))
        {
            return false;
        }

        var normalized = workName
            .Trim()
            .ToLowerInvariant()
            .Replace("ё", "е");

        return normalized == "консультация к госэкзамену"
               || normalized == "консультации к госэкзамену";
    }
}

@if (Model.Count == 0)
{
    <div class="alert alert-light border">
        Нет строк для отображения.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Семестр</th>
                    <th>Код направления</th>
                    <th>Вид работы</th>
                    <th class="text-center">Курс</th>
                    <th class="text-center">Групп</th>
                    <th class="text-center">Студентов</th>
                    <th class="text-center">Часы</th>
                    <th class="text-center">Итого</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    var directionColor = directionColorMap.TryGetValue(row.DirectionCode, out var color)
                    ? color
                    : "#ffffff";

                    <tr style="background-color: @directionColor;">
                        <td>@row.SemesterName</td>
                        <td>@row.DirectionCode</td>
                        <td>@row.WorkName</td>
                        <td class="text-center">@row.Course</td>
                        <td class="text-center">@row.GroupCount</td>
                        <td class="text-center">@row.StudentsCount</td>
                        <td class="text-center">
                            @if (IsStateExamConsultation(row.WorkName))
                            {
                                <span class="fw-semibold">@FormatDecimal(row.ManualHours)</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td class="text-center fw-bold">@FormatDecimal(row.TotalHours)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}