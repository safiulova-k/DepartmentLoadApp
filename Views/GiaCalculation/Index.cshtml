@model DepartmentLoadApp.ViewModels.Gia.GiaWorkloadPageViewModel

@{
    ViewData["Title"] = "ГИА";

    var stateExamRows = Model.Rows
        .Where(x => x.GiaSection == "Госэкзамен")
        .ToList();

    var vkrRows = Model.Rows
        .Where(x => x.GiaSection == "Дипломное проектирование")
        .ToList();

    var gecRows = Model.Rows
        .Where(x => x.GiaSection == "ГЭК")
        .ToList();

    var pastelColors = new[]
    {
        "#fff4d6",
        "#e3f2fd",
        "#e8f5e9",
        "#fce4ec",
        "#ede7f6",
        "#e0f7fa",
        "#f3e5f5",
        "#fffde7",
        "#f1f8e9",
        "#e8eaf6"
    };

    var directions = (Model.Rows ?? new())
        .Select(x => x.DirectionCode)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();

    var directionColorMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

    for (var i = 0; i < directions.Count; i++)
    {
        directionColorMap[directions[i]] = pastelColors[i % pastelColors.Length];
    }
}

<h1 class="mb-4">Расчет нагрузки по ГИА</h1>

@await Html.PartialAsync(
        "_CalculationTopPanel",
        new DepartmentLoadApp.ViewModels.Shared.CalculationTopPanelViewModel
    {
        SelectedYear = Model.SelectedYear,
        SelectedYearStart = Model.SelectedYearStart,
        AvailableYearStarts = Model.AvailableYearStarts,
        ActiveTab = "gia"
    })

<div class="alert alert-light border mb-3">
    Для ГИА строки создаются автоматически из учебных планов.
    Часы консультаций к госэкзамену задаются на странице норм времени.
    Расчет выполняется общей кнопкой <strong>Рассчитать</strong>.
</div>

@if (Model.Rows == null || !Model.Rows.Any())
{
    <div class="alert alert-info">
        По выбранному учебному году данных пока нет.
    </div>
}
else
{
    <div class="d-flex flex-wrap gap-2 mb-3">
        @foreach (var direction in directions)
        {
            <span class="badge rounded-pill text-dark border bg-white px-3 py-2">
                <span class="d-inline-block rounded-circle me-2"
                      style="width: 18px; height: 18px; background-color: @directionColorMap[direction]; vertical-align: middle;">
                </span>
                @direction
            </span>
        }
    </div>

    <h3 class="mt-4 mb-3">Госэкзамен</h3>

    @await Html.PartialAsync(
                "_GiaTable",
                stateExamRows,
                new ViewDataDictionary(ViewData)
        {
            ["DirectionColorMap"] = directionColorMap
        })

    <h3 class="mt-4 mb-3">Дипломное проектирование</h3>

    @await Html.PartialAsync(
                "_GiaTable",
                vkrRows,
                new ViewDataDictionary(ViewData)
        {
            ["DirectionColorMap"] = directionColorMap
        })

    <h3 class="mt-4 mb-3">ГЭК</h3>

    @await Html.PartialAsync(
                "_GiaTable",
                gecRows,
                new ViewDataDictionary(ViewData)
        {
            ["DirectionColorMap"] = directionColorMap
        })
}

@section Scripts {
}