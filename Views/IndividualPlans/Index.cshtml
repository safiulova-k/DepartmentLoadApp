@model DepartmentLoadApp.ViewModels.IndividualPlans.IndividualPlansPageViewModel

@{
    ViewData["Title"] = "Индивидуальные планы";
}

<style>
    .individual-current-year-line {
        width: 100%;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        background: #f8f9fa;
        padding: 10px 14px;
        margin-bottom: 14px;
        font-size: 1.08rem;
        font-weight: 600;
    }

    .individual-plans-toolbar {
        display: grid;
        grid-template-columns: minmax(320px, 1fr) 230px 230px;
        gap: 12px;
        align-items: end;
        margin-bottom: 18px;
    }

    .individual-plans-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }

    .individual-plans-table th {
        vertical-align: middle;
        white-space: nowrap;
    }

    .individual-plans-table td {
        vertical-align: middle;
    }

    @@media (max-width: 991.98px) {
        .individual-plans-toolbar {
            grid-template-columns: 1fr;
        }

        .individual-plans-actions {
            justify-content: flex-start;
        }
    }
</style>

<h1>Индивидуальные планы преподавателей</h1>

<div class="individual-current-year-line">
    Текущий учебный год: @Model.SelectedAcademicYear
</div>

<div class="individual-plans-toolbar">
    <div>
        <label class="form-label">Поиск преподавателя</label>
        <input type="text"
               class="form-control form-control-sm js-individual-search"
               placeholder="Введите ФИО или должность" />
    </div>

    <div>
        <label class="form-label">Фильтр</label>
        <select class="form-select form-select-sm js-individual-filter">
            <option value="all">Все преподаватели</option>
            <option value="with-load">С нагрузкой</option>
            <option value="without-load">Без нагрузки</option>
            <option value="assistant">Ассистенты</option>
        </select>
    </div>

    <div>
        <label class="form-label">Сортировка</label>
        <select class="form-select form-select-sm js-individual-sort">
            <option value="name-asc">По ФИО</option>
            <option value="assigned-desc">Больше часов</option>
            <option value="assigned-asc">Меньше часов</option>
            <option value="rate-desc">Больше ставка</option>
            <option value="rate-asc">Меньше ставка</option>
        </select>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (!Model.TemplateExists)
{
    <div class="alert alert-warning">
        Не найден Excel-шаблон. Помести файл шаблона по пути Templates/IndividualPlanTemplate.xlsx.
    </div>
}

<div class="individual-plans-actions">
    <form asp-action="ExportAll" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="startYear" value="@Model.SelectedYearStart" />

        <button type="submit"
                class="btn btn-success"
        @(Model.TemplateExists ? "" : "disabled")>
            Выгрузить все планы
        </button>
    </form>
</div>

@if (Model.Lecturers.Count == 0)
{
    <div class="alert alert-info">
        Для текущего учебного года преподаватели не найдены.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped individual-plans-table">
            <thead class="table-dark">
                <tr>
                    <th>ФИО</th>
                    <th>Учебная должность</th>
                    <th>Ставка</th>
                    <th>Распределено часов</th>
                    <th>Действия</th>
                </tr>
            </thead>

            <tbody class="js-individual-table-body">
                @foreach (var lecturer in Model.Lecturers)
                {
                    <tr class="js-individual-row"
                        data-name="@((lecturer.FullName ?? string.Empty).ToLower())"
                        data-post="@((lecturer.StudyPostTitle ?? string.Empty).ToLower())"
                        data-assigned="@lecturer.AssignedHours"
                        data-rate="@lecturer.Rate.ToString("0.####").Replace(",", ".")"
                        data-assistant="@((lecturer.StudyPostTitle ?? string.Empty).ToLower().Contains("ассистент") ? "true" : "false")">
                        <td>@lecturer.FullName</td>
                        <td>@lecturer.StudyPostTitle</td>
                        <td>@lecturer.Rate.ToString("0.##")</td>
                        <td>@lecturer.AssignedHours</td>
                        <td>
                            <form asp-action="Export" method="post" class="m-0">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="startYear" value="@Model.SelectedYearStart" />
                                <input type="hidden" name="lecturerId" value="@lecturer.LecturerId" />

                                <button type="submit"
                                        class="btn btn-outline-primary btn-sm"
                                @(Model.TemplateExists ? "" : "disabled")>
                                    Выгрузить план
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        function parseIndividualNumber(value) {
            if (!value) {
                return 0;
            }

            return Number(String(value).replace(",", ".")) || 0;
        }

        function applyIndividualFiltersAndSort() {
            const tbody = document.querySelector(".js-individual-table-body");

            if (!tbody) {
                return;
            }

            const search = (document.querySelector(".js-individual-search")?.value || "").toLowerCase().trim();
            const filter = document.querySelector(".js-individual-filter")?.value || "all";
            const sort = document.querySelector(".js-individual-sort")?.value || "name-asc";
            const rows = Array.from(tbody.querySelectorAll(".js-individual-row"));

            rows.forEach(function (row) {
                const name = row.dataset.name || "";
                const post = row.dataset.post || "";
                const assigned = parseIndividualNumber(row.dataset.assigned);
                const assistant = row.dataset.assistant === "true";

                let visible = true;

                if (search && !name.includes(search) && !post.includes(search)) {
                    visible = false;
                }

                if (filter === "with-load" && assigned <= 0) {
                    visible = false;
                }

                if (filter === "without-load" && assigned > 0) {
                    visible = false;
                }

                if (filter === "assistant" && !assistant) {
                    visible = false;
                }

                row.classList.toggle("d-none", !visible);
            });

            rows.sort(function (a, b) {
                const nameA = a.dataset.name || "";
                const nameB = b.dataset.name || "";
                const assignedA = parseIndividualNumber(a.dataset.assigned);
                const assignedB = parseIndividualNumber(b.dataset.assigned);
                const rateA = parseIndividualNumber(a.dataset.rate);
                const rateB = parseIndividualNumber(b.dataset.rate);

                if (sort === "assigned-desc") {
                    return assignedB - assignedA || nameA.localeCompare(nameB);
                }

                if (sort === "assigned-asc") {
                    return assignedA - assignedB || nameA.localeCompare(nameB);
                }

                if (sort === "rate-desc") {
                    return rateB - rateA || nameA.localeCompare(nameB);
                }

                if (sort === "rate-asc") {
                    return rateA - rateB || nameA.localeCompare(nameB);
                }

                return nameA.localeCompare(nameB);
            });

            rows.forEach(function (row) {
                tbody.appendChild(row);
            });
        }

        document.addEventListener("input", function (event) {
            if (event.target.classList.contains("js-individual-search")) {
                applyIndividualFiltersAndSort();
            }
        });

        document.addEventListener("change", function (event) {
            if (event.target.classList.contains("js-individual-filter")
                || event.target.classList.contains("js-individual-sort")) {
                applyIndividualFiltersAndSort();
            }
        });

        applyIndividualFiltersAndSort();
    </script>
}