@model DepartmentLoadApp.ViewModels.NormTime.NormTimePageViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Нормы времени";

    var groupedItems = Model.Items
        .GroupBy(x => x.CategoryName)
        .OrderBy(x => x.Key)
        .ToList();

    var activeTab = Model.ActiveTab;
    var hasActiveTab = !string.IsNullOrWhiteSpace(activeTab);

    static bool IsWeeksCategory(string? categoryName)
    {
        if (string.IsNullOrWhiteSpace(categoryName))
        {
            return false;
        }

        var normalized = categoryName
            .Trim()
            .ToLowerInvariant()
            .Replace("ё", "е");

        return normalized.Contains("практи")
               || normalized.Contains("науч");
    }

    static string FormatDecimal(decimal value)
    {
        return value.ToString("0.##", CultureInfo.GetCultureInfo("ru-RU"));
    }
}

<h1 class="mb-3">Нормы времени</h1>

<p class="text-muted">
    Для каждого вида работы задается основа расчета и значение нормы.
</p>

<p class="text-muted">
    Для строк Лекции, Практические занятия и Лабораторные работы в поле Часы указывается 1,
    так как итоговая нагрузка для них считается по формуле:
    часы по плану × потоки / группы / подгруппы.
</p>

<p class="text-muted">
    Для строк категорий Практика и Научная работа задается количество недель и коэффициент.
    Итог по практикам считается по формуле:
    количество недель × основа расчета × коэффициент.
</p>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<form asp-action="Save" method="post" id="normTimeForm">
    @Html.AntiForgeryToken()

    <input type="hidden" name="activeTab" id="activeTabInput" value="@activeTab" />
    <input type="hidden" name="startYear" value="@Model.SelectedYearStart" />

    <ul class="nav nav-tabs mb-4" id="normTimeTabs" role="tablist">
        @for (var g = 0; g < groupedItems.Count; g++)
        {
            var categoryName = groupedItems[g].Key;
            var paneId = $"pane-{g}";
            var isActive = hasActiveTab
            ? activeTab == paneId
            : g == 0;

            <li class="nav-item" role="presentation">
                <button class="nav-link @(isActive ? "active" : "")"
                        id="tab-@g"
                        data-bs-toggle="tab"
                        data-bs-target="#@paneId"
                        type="button"
                        role="tab"
                        aria-controls="@paneId"
                        aria-selected="@(isActive ? "true" : "false")">
                    @categoryName
                </button>
            </li>
        }

        @{
            var additionalPaneId = "pane-additional";
            var additionalActive = hasActiveTab && activeTab == additionalPaneId;
        }

        <li class="nav-item" role="presentation">
            <button class="nav-link @(additionalActive ? "active" : "")"
                    id="tab-additional"
                    data-bs-toggle="tab"
                    data-bs-target="#@additionalPaneId"
                    type="button"
                    role="tab"
                    aria-controls="@additionalPaneId"
                    aria-selected="@(additionalActive ? "true" : "false")">
                Доп. работа
            </button>
        </li>
    </ul>

    <div class="tab-content">
        @for (var g = 0; g < groupedItems.Count; g++)
        {
            var group = groupedItems[g].ToList();
            var categoryName = groupedItems[g].Key;
            var paneId = $"pane-{g}";
            var isActive = hasActiveTab
            ? activeTab == paneId
            : g == 0;
            var showWeeks = IsWeeksCategory(categoryName);

            <div class="tab-pane fade @(isActive ? "show active" : "")"
                 id="@paneId"
                 role="tabpanel"
                 aria-labelledby="tab-@g">

                <h3 class="mb-3">@categoryName</h3>

                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Вид работы</th>
                                <th style="width: 280px;">Основа расчета</th>
                                @if (showWeeks)
                                {
                                    <th style="width: 160px;">Недель</th>
                                    <th style="width: 160px;">Коэффициент</th>
                                }
                                else
                                {
                                    <th style="width: 160px;">Часы</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in group)
                            {
                                var index = Model.Items.FindIndex(x => x.Id == row.Id);

                                <tr>
                                    <td>
                                        @row.WorkName

                                        <input type="hidden"
                                               name="Items[@index].Id"
                                               value="@row.Id" />

                                        @if (!showWeeks)
                                        {
                                            <input type="hidden"
                                                   name="Items[@index].WeeksCount"
                                                   value="@row.WeeksCount" />
                                        }
                                    </td>

                                    <td>
                                        <select class="form-select"
                                                name="Items[@index].CalculationBase">
                                            @foreach (var item in Model.CalculationBaseItems)
                                            {
                                                var isSelected = item.Value == ((int)row.CalculationBase).ToString();

                                                <option value="@item.Value" selected="@isSelected">
                                                    @item.Text
                                                </option>
                                            }
                                        </select>
                                    </td>

                                    @if (showWeeks)
                                    {
                                        <td>
                                            <input class="form-control"
                                                   type="number"
                                                   min="0"
                                                   step="1"
                                                   name="Items[@index].WeeksCount"
                                                   value="@row.WeeksCount" />
                                        </td>

                                        <td>
                                            <input class="form-control"
                                                   type="text"
                                                   name="Items[@index].Hours"
                                                   value="@FormatDecimal(row.Hours)" />
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                            <input class="form-control"
                                                   type="text"
                                                   name="Items[@index].Hours"
                                                   value="@FormatDecimal(row.Hours)" />
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="tab-pane fade @(additionalActive ? "show active" : "")"
             id="pane-additional"
             role="tabpanel"
             aria-labelledby="tab-additional">

            <h3 class="mb-3">Доп. работа</h3>

            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Вид работы</th>
                            <th style="width: 180px;">Количество</th>
                            <th style="width: 180px;">Часы</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.AdditionalWorkNorms.Count; i++)
                        {
                            var row = Model.AdditionalWorkNorms[i];

                            <tr>
                                <td>
                                    @row.Name

                                    <input type="hidden"
                                           name="AdditionalWorkNorms[@i].Id"
                                           value="@row.Id" />
                                </td>

                                <td>
                                    @if (row.IsPostgraduate)
                                    {
                                        <input class="form-control"
                                               type="number"
                                               min="0"
                                               step="1"
                                               name="AdditionalWorkNorms[@i].Count"
                                               value="@row.Count" />
                                    }
                                    else
                                    {
                                        <span class="fw-semibold">1</span>

                                        <input type="hidden"
                                               name="AdditionalWorkNorms[@i].Count"
                                               value="1" />
                                    }
                                </td>

                                <td>
                                    <input class="form-control"
                                           type="text"
                                           name="AdditionalWorkNorms[@i].Hours"
                                           value="@FormatDecimal(row.Hours)" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end mt-4">
        <button type="submit" class="btn btn-primary px-4">
            Сохранить
        </button>
    </div>
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const activeTabInput = document.getElementById('activeTabInput');

            document
                .querySelectorAll('#normTimeTabs button[data-bs-toggle="tab"]')
                .forEach(function (button) {
                    button.addEventListener('shown.bs.tab', function (event) {
                        const target = event.target.getAttribute('data-bs-target');

                        if (!target || !activeTabInput) {
                            return;
                        }

                        activeTabInput.value = target.replace('#', '');
                    });
                });
        });
    </script>
}

@functions {
    private static string FormatDecimal(decimal value)
    {
        return value.ToString("0.##", CultureInfo.GetCultureInfo("ru-RU"));
    }
}