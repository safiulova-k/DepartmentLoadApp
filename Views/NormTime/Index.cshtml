@model DepartmentLoadApp.Models.NormTime.NormTimePageViewModel
@using DepartmentLoadApp.Models.Enums

@{
    ViewData["Title"] = "Нормы времени";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-0 pb-0 d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <h2 class="mb-1">Нормы времени</h2>
                <p class="text-muted mb-3">Справочник нормативов для автоматического расчета нагрузки</p>
            </div>

            <div>
                <a asp-controller="NormTime" asp-action="Create" class="btn btn-primary">
                    Добавить норму
                </a>
            </div>
        </div>

        <div class="card-body pt-0">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }

            <div class="table-responsive">
                <table class="table table-bordered align-middle norm-table">
                    <thead>
                        <tr>
                            <th>Вид нагрузки</th>
                            <th class="text-center">Тип расчета</th>
                            <th class="text-center">Единица</th>
                            <th class="text-center">Норма, часов</th>
                            <th>Комментарий</th>
                            <th class="text-center">Активно</th>
                            <th class="text-center actions-col">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    Список норм времени пока пуст
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in Model.Rows)
                            {
                                <tr>
                                    <td class="fw-semibold">@row.WorkTypeName</td>
                                    <td class="text-center">
                                        @switch (row.CalculationType)
                                        {
                                            case NormCalculationType.PerStudent:
                                                @:На студента
                                                break;
                                            case NormCalculationType.PerGroup:
                                                @:На группу
                                                break;
                                            case NormCalculationType.PerSubgroup:
                                                @:На подгруппу
                                                break;
                                            case NormCalculationType.PerFlow:
                                                @:На поток
                                                break;
                                            case NormCalculationType.Fixed:
                                                @:Фиксированно
                                                break;
                                        }
                                    </td>
                                    <td class="text-center">@row.UnitName</td>
                                    <td class="text-center">@row.HoursValue</td>
                                    <td>@row.Note</td>
                                    <td class="text-center">
                                        @if (row.IsActive)
                                        {
                                            <span class="badge bg-success">Да</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Нет</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                                            <a asp-controller="NormTime"
                                               asp-action="Edit"
                                               asp-route-id="@row.Id"
                                               class="btn btn-outline-primary btn-sm">
                                                Изменить
                                            </a>

                                            <form asp-controller="NormTime"
                                                  asp-action="Delete"
                                                  asp-route-id="@row.Id"
                                                  method="post"
                                                  class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                                    Удалить
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .norm-table th,
    .norm-table td {
        vertical-align: middle;
    }

    .norm-table thead th {
        background: #f3f6fb;
        font-weight: 700;
    }

    .norm-table .actions-col {
        min-width: 180px;
    }
</style>