@model List<DepartmentLoadApp.Models.AcademicPlan.Discipline>

@{
    ViewData["Title"] = "Дисциплины";
}
@{
    var currentStartYear = DateTime.Now.Month >= 9 ? DateTime.Now.Year : DateTime.Now.Year - 1;
    string latestYear = ViewBag.LatestYear as string ?? $"{currentStartYear}-{currentStartYear + 1}";
}


<h1>Дисциплины</h1>

<div class="mb-3 d-flex gap-2 flex-wrap">
    <form asp-action="ImportFromAcademicPlan" method="post" class="d-flex gap-2">
        @Html.AntiForgeryToken()
        <input type="number"
               name="year"
               value="@latestYear"
               class="form-control"
               style="width:140px;" />
        <button type="submit" class="btn btn-primary">
            Импортировать из учебного плана
        </button>
    </form>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control"
               placeholder="Поиск по названию дисциплины" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Найти</button>
        <a asp-action="Index" class="btn btn-secondary">Сбросить</a>
    </div>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Название дисциплины</th>
            <th>Короткое название</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="4" class="text-center">Дисциплины не найдены</td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.DisciplineName</td>
                    <td>@item.DisciplineShortName</td>
                </tr>
            }
        }
    </tbody>
</table>