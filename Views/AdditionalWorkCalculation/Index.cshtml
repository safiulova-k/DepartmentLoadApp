@model DepartmentLoadApp.ViewModels.AdditionalWorkCalculation.AdditionalWorkCalculationPageViewModel

@{
    ViewData["Title"] = "Доп. работа";
}

<h1 class="mb-4">Расчет дополнительной работы</h1>

@await Html.PartialAsync(
        "_CalculationTopPanel",
        new DepartmentLoadApp.ViewModels.Shared.CalculationTopPanelViewModel
    {
        SelectedYear = Model.SelectedYear,
        SelectedYearStart = Model.SelectedYearStart,
        AvailableYearStarts = Model.AvailableYearStarts,
        ActiveTab = "additional"
    })

<div class="table-responsive">
    <table class="table table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Вид работы</th>
                <th class="text-center" style="width: 180px;">Количество</th>
                <th class="text-center" style="width: 180px;">Норма часов</th>
                <th class="text-center" style="width: 180px;">Итого</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td>@row.WorkName</td>
                    <td class="text-center fw-semibold">@row.Count</td>
                    <td class="text-center">@row.HoursPerUnit.ToString("0.##")</td>
                    <td class="text-center fw-bold">@row.TotalHours ч.</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="table-light">
                <th colspan="3" class="text-end">Итого</th>
                <th class="text-center">@Model.TotalHours ч.</th>
            </tr>
        </tfoot>
    </table>
</div>